index d588aaa..4979ae9 100644
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -1031,6 +1031,45 @@ sweet_rtc_store_write(uint64_t offset, uint64_t raw)
 	return error;
 }
 
+/*
+ * Wi-Fi test credentials (sunstone, TopazModem wlantest=1): the device block below the RTC record,
+ *   "SWEETWLN" | u32 version 1 | u32 ssid length | u32 passphrase length | u32 0 | ssid[32] | pass[64]
+ * written from a recovery by tools/sweet-wlan-seed.sh, so the passphrase is in neither the boot image,
+ * the boot-args nor the console log. Read-only here; the bounce buffer is wiped after the copy.
+ */
+int sweet_wlan_store_read(uint8_t ssid[32], unsigned *ssid_len, uint8_t pass[64], unsigned *pass_len);
+
+int
+sweet_wlan_store_read(uint8_t ssid[32], unsigned *ssid_len, uint8_t pass[64], unsigned *pass_len)
+{
+	struct { char magic[8]; uint32_t version, slen, plen, pad; uint8_t ssid[32], pass[64]; } r;
+	int error;
+
+	if (!su.ready || su.nblocks < 2 * SWEET_LOG_BLOCKS) {
+		return ENXIO;
+	}
+	lck_mtx_lock(&sweet_ufs_lock);
+	error = ufs_read_blocks(sweet_rtc_block() - 1, 1);
+	if (!error) {
+		memcpy(&r, (void *)(su.dma + DMA_BOUNCE), sizeof(r));
+		bzero((void *)(su.dma + DMA_BOUNCE), UFS_BLOCK);
+	}
+	lck_mtx_unlock(&sweet_ufs_lock);
+	if (error) {
+		return error;
+	}
+	if (memcmp(r.magic, "SWEETWLN", 8) != 0 || r.version != 1 || r.slen == 0 || r.slen > 32 || r.plen > 63) {
+		bzero(&r, sizeof(r));
+		return ENOENT;
+	}
+	memcpy(ssid, r.ssid, 32);
+	memcpy(pass, r.pass, 64);
+	*ssid_len = r.slen;
+	*pass_len = r.plen;
+	bzero(&r, sizeof(r));
+	return 0;
+}
+
 static void
 sweet_rtc_store_boot(void)
 {
diff --git a/iokit/Kernel/arm/TopazModem.cpp b/iokit/Kernel/arm/TopazModem.cpp
index 16e5de5..430abc6 100644
--- a/iokit/Kernel/arm/TopazModem.cpp
+++ b/iokit/Kernel/arm/TopazModem.cpp
@@ -25,6 +25,7 @@
 #include <IOKit/IOLib.h>
 #include <IOKit/IOMemoryDescriptor.h>
 #include <kern/thread.h>
+#include <kern/clock.h>
 #include <pexpert/pexpert.h>
 #include <libkern/crc.h>
 #include <sys/param.h>
@@ -6382,6 +6383,271 @@ topaz_modem_thread(void *arg __unused, wait_result_t wr __unused)
 	thread_terminate(current_thread());
 }
 
+/* ---------------------------------------------------------------- Wi-Fi data-path test (sunstone) */
+
+/*
+ * Boot-args modem=1 wifi=1 wlantest=1: once the radio API is ready, join the network stored by
+ * tools/sweet-wlan-seed.sh (bsd/dev/sweet_ufs.c, never logged), then prove the data path both
+ * ways with a minimal DHCP client (DISCOVER/OFFER/REQUEST/ACK), ARP replies for the leased
+ * address and four ICMP echoes to the router. Everything is logged as "wlantest:".
+ */
+extern "C" int sweet_wlan_store_read(uint8_t ssid[32], unsigned *ssid_len, uint8_t pass[64], unsigned *pass_len);
+
+static uint8_t  wt_mac[6], wt_router_mac[6];
+static uint32_t wt_xid, wt_ip, wt_server, wt_router, wt_dns, wt_lease, wt_mask;
+static volatile int wt_dhcp;                    /* 0 discover, 1 offered, 2 acked */
+static volatile uint32_t wt_pongs, wt_arps, wt_rxn;
+static uint64_t wt_ping_sent[4];
+
+static uint16_t
+wt_csum(const uint8_t *p, unsigned n, uint32_t sum)
+{
+	for (unsigned i = 0; i + 1 < n; i += 2) {
+		sum += (uint32_t)p[i] << 8 | p[i + 1];
+	}
+	if (n & 1) {
+		sum += (uint32_t)p[n - 1] << 8;
+	}
+	while (sum >> 16) {
+		sum = (sum & 0xffff) + (sum >> 16);
+	}
+	return (uint16_t)~sum;
+}
+
+static void wt_put16(uint8_t *p, uint16_t v) { p[0] = (uint8_t)(v >> 8); p[1] = (uint8_t)v; }
+static void wt_put32(uint8_t *p, uint32_t v) { p[0] = (uint8_t)(v >> 24); p[1] = (uint8_t)(v >> 16); p[2] = (uint8_t)(v >> 8); p[3] = (uint8_t)v; }
+static uint32_t wt_get32(const uint8_t *p) { return (uint32_t)p[0] << 24 | (uint32_t)p[1] << 16 | (uint32_t)p[2] << 8 | p[3]; }
+
+/* Ethernet + IPv4 headers around a payload already at f + 34; returns the frame length */
+static size_t
+wt_ipframe(uint8_t *f, const uint8_t dst_mac[6], uint8_t proto, uint32_t src, uint32_t dst, unsigned plen)
+{
+	memcpy(f, dst_mac, 6);
+	memcpy(f + 6, wt_mac, 6);
+	f[12] = 0x08; f[13] = 0x00;
+	uint8_t *ip = f + 14;
+	ip[0] = 0x45; ip[1] = 0;
+	wt_put16(ip + 2, (uint16_t)(20 + plen));
+	wt_put16(ip + 4, (uint16_t)(wt_xid & 0xffff));
+	ip[6] = 0; ip[7] = 0; ip[8] = 64; ip[9] = proto;
+	ip[10] = 0; ip[11] = 0;
+	wt_put32(ip + 12, src);
+	wt_put32(ip + 16, dst);
+	wt_put16(ip + 10, wt_csum(ip, 20, 0));
+	return 34 + plen;
+}
+
+static void
+wt_dhcp_send(int type)
+{
+	static const uint8_t bcast[6] = { 0xff, 0xff, 0xff, 0xff, 0xff, 0xff };
+	uint8_t f[400];
+	bzero(f, sizeof(f));
+	uint8_t *udp = f + 34, *b = udp + 8;
+	b[0] = 1; b[1] = 1; b[2] = 6;
+	wt_put32(b + 4, wt_xid);
+	wt_put16(b + 10, 0x8000);                   /* broadcast replies: we have no address yet */
+	memcpy(b + 28, wt_mac, 6);
+	wt_put32(b + 236, 0x63825363);
+	uint8_t *o = b + 240;
+	*o++ = 53; *o++ = 1; *o++ = (uint8_t)type;
+	if (type == 3) {
+		*o++ = 50; *o++ = 4; wt_put32(o, wt_ip); o += 4;
+		*o++ = 54; *o++ = 4; wt_put32(o, wt_server); o += 4;
+	}
+	*o++ = 55; *o++ = 4; *o++ = 1; *o++ = 3; *o++ = 6; *o++ = 51;
+	*o++ = 255;
+	unsigned blen = (unsigned)(o - b);
+	if (blen < 300) {
+		blen = 300;
+	}
+	wt_put16(udp, 68);
+	wt_put16(udp + 2, 67);
+	wt_put16(udp + 4, (uint16_t)(8 + blen));
+	size_t n = wt_ipframe(f, bcast, 17, 0, 0xffffffffu, 8 + blen);
+	(void)topaz_wlan_transmit(f, n);
+}
+
+static void
+wt_ping(unsigned seq)
+{
+	uint8_t f[34 + 8 + 56];
+	bzero(f, sizeof(f));
+	uint8_t *icmp = f + 34;
+	icmp[0] = 8;
+	wt_put16(icmp + 4, 0x5357);                 /* "SW" */
+	wt_put16(icmp + 6, (uint16_t)seq);
+	for (unsigned i = 0; i < 56; i++) {
+		icmp[8 + i] = (uint8_t)i;
+	}
+	wt_put16(icmp + 2, wt_csum(icmp, 64, 0));
+	size_t n = wt_ipframe(f, wt_router_mac, 1, wt_ip, wt_router, 64);
+	wt_ping_sent[seq & 3] = mach_absolute_time();
+	(void)topaz_wlan_transmit(f, n);
+}
+
+static void
+wt_rx(const uint8_t *e, size_t len)
+{
+	wt_rxn++;
+	if (len >= 42 && e[12] == 0x08 && e[13] == 0x06) {         /* ARP */
+		const uint8_t *a = e + 14;
+		if (a[7] == 1 && wt_dhcp == 2 && wt_get32(a + 24) == wt_ip) {
+			uint8_t r[42];
+			memcpy(r, a + 8, 6);
+			memcpy(r + 6, wt_mac, 6);
+			r[12] = 0x08; r[13] = 0x06;
+			memcpy(r + 14, a, 6);
+			r[20] = 0; r[21] = 2;
+			memcpy(r + 22, wt_mac, 6);
+			wt_put32(r + 28, wt_ip);
+			memcpy(r + 32, a + 8, 10);              /* their MAC and IP */
+			(void)topaz_wlan_transmit(r, sizeof(r));
+			wt_arps++;
+		}
+		return;
+	}
+	if (len < 34 || e[12] != 0x08 || e[13] != 0x00 || (e[14] >> 4) != 4) {
+		return;
+	}
+	const uint8_t *ip = e + 14;
+	unsigned ihl = (ip[0] & 15) * 4u;
+	if (len < 14 + ihl + 8) {
+		return;
+	}
+	const uint8_t *l4 = ip + ihl;
+	if (ip[9] == 1 && l4[0] == 0 && l4[4] == 0x53 && l4[5] == 0x57) {   /* echo reply to us */
+		unsigned seq = (unsigned)l4[6] << 8 | l4[7];
+		uint64_t ns;
+		absolutetime_to_nanoseconds(mach_absolute_time() - wt_ping_sent[seq & 3], &ns);
+		wt_pongs++;
+		LOG("wlantest: echo reply %u from %u.%u.%u.%u: %llu us", seq, ip[12], ip[13], ip[14], ip[15], ns / 1000);
+		return;
+	}
+	if (ip[9] != 17 || l4[2] != 0 || l4[3] != 68 || len < 14 + ihl + 8 + 240) {
+		return;
+	}
+	const uint8_t *b = l4 + 8;
+	if (b[0] != 2 || wt_get32(b + 4) != wt_xid || wt_get32(b + 236) != 0x63825363) {
+		return;
+	}
+	int type = 0;
+	uint32_t server = 0;
+	const uint8_t *end = e + len;
+	for (const uint8_t *o = b + 240; o < end && *o != 255;) {
+		if (*o == 0) {
+			o++;
+			continue;
+		}
+		if (o + 2 > end || o + 2 + o[1] > end) {
+			break;
+		}
+		const uint8_t *v = o + 2;
+		switch (o[0]) {
+		case 53: type = v[0]; break;
+		case 54: if (o[1] >= 4) server = wt_get32(v); break;
+		case 1:  if (o[1] >= 4) wt_mask = wt_get32(v); break;
+		case 3:  if (o[1] >= 4) wt_router = wt_get32(v); break;
+		case 6:  if (o[1] >= 4) wt_dns = wt_get32(v); break;
+		case 51: if (o[1] >= 4) wt_lease = wt_get32(v); break;
+		}
+		o += 2 + o[1];
+	}
+	if (type == 2 && wt_dhcp == 0) {
+		wt_ip = wt_get32(b + 16);
+		wt_server = server;
+		wt_dhcp = 1;
+	} else if (type == 5 && wt_dhcp == 1) {
+		memcpy(wt_router_mac, e + 6, 6);         /* the AP/router that sent the ACK */
+		wt_dhcp = 2;
+	}
+}
+
+#define WT_IP4(a) (unsigned)((a) >> 24), (unsigned)(((a) >> 16) & 255), (unsigned)(((a) >> 8) & 255), (unsigned)((a) & 255)
+
+static void
+topaz_wlan_test_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	uint8_t ssid[32], pass[64];
+	unsigned slen = 0, plen = 0;
+	for (int i = 0; i < 600 && !topaz_wlan_ready(); i++) {
+		IOSleep(200);
+	}
+	if (!topaz_wlan_ready()) {
+		LOG("wlantest: radio never became ready");
+		goto out;
+	}
+	if (sweet_wlan_store_read(ssid, &slen, pass, &plen) != 0) {
+		LOG("wlantest: no SWEETWLN record on userdata (tools/sweet-wlan-seed.sh)");
+		goto out;
+	}
+	topaz_wlan_address(wt_mac);
+	read_random(&wt_xid, sizeof(wt_xid));
+	IOSleep(6000);                              /* let a scan hear the network */
+	for (int attempt = 1; attempt <= 3; attempt++) {
+		int r = topaz_wlan_join(ssid, slen, NULL, pass, plen);
+		LOG("wlantest: join \"%.*s\" (%s) attempt %d -> %d", (int)slen, ssid, plen ? "WPA2-PSK" : "open", attempt, r);
+		if (r == 0) {
+			break;
+		}
+		IOSleep(15000);
+	}
+	bzero(pass, sizeof(pass));
+	if (!topaz_wlan_joined()) {
+		goto out;
+	}
+	topaz_wlan_rx_hook = wt_rx;
+	for (int i = 0; i < 10 && wt_dhcp == 0; i++) {
+		wt_dhcp_send(1);
+		for (int k = 0; k < 20 && wt_dhcp == 0; k++) {
+			IOSleep(100);
+		}
+	}
+	if (wt_dhcp == 0) {
+		LOG("wlantest: no DHCP offer (rx %u frames)", wt_rxn);
+		goto out;
+	}
+	LOG("wlantest: DHCP offer %u.%u.%u.%u from %u.%u.%u.%u", WT_IP4(wt_ip), WT_IP4(wt_server));
+	for (int i = 0; i < 5 && wt_dhcp == 1; i++) {
+		wt_dhcp_send(3);
+		for (int k = 0; k < 20 && wt_dhcp == 1; k++) {
+			IOSleep(100);
+		}
+	}
+	if (wt_dhcp != 2) {
+		LOG("wlantest: no DHCP ACK");
+		goto out;
+	}
+	LOG("wlantest: *** DHCP ACK: %u.%u.%u.%u mask %u.%u.%u.%u router %u.%u.%u.%u dns %u.%u.%u.%u lease %u s ***",
+	    WT_IP4(wt_ip), WT_IP4(wt_mask), WT_IP4(wt_router), WT_IP4(wt_dns), wt_lease);
+	if (wt_router == 0) {
+		wt_router = wt_server;
+	}
+	for (unsigned seq = 0; seq < 4; seq++) {
+		wt_ping(seq);
+		IOSleep(1000);
+	}
+	IOSleep(1000);
+	LOG("wlantest: *** %u/4 echo replies from %u.%u.%u.%u, %u ARP replies sent, %u frames received ***",
+	    wt_pongs, WT_IP4(wt_router), wt_arps, wt_rxn);
+out:
+	bzero(pass, sizeof(pass));
+	thread_terminate(current_thread());
+}
+
+static void
+topaz_wlan_test_start(void)
+{
+	uint32_t on = 0;
+	thread_t thread;
+	if (!PE_parse_boot_argn("wlantest", &on, sizeof(on)) || on == 0 || !wifi_enabled()) {
+		return;
+	}
+	if (kernel_thread_start(topaz_wlan_test_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+
 extern "C" void
 topaz_modem_init(void)
 {
@@ -6396,6 +6662,7 @@ topaz_modem_init(void)
 	if (kernel_thread_start(topaz_modem_thread, NULL, &thread) == KERN_SUCCESS) {
 		thread_deallocate(thread);
 	}
+	topaz_wlan_test_start();
 }
 
