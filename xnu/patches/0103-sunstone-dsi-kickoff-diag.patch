+/*
+ * One command DMA, as techpack dsi_ctrl_hw_cmn_kickoff_command(): embedded
+ * mode (bit 28), packet type 0 (bit 24), WC_SEL 0 (bit 29), LP11 or HS (bit
+ * 26), DMA FIFO watermarks off, every DSI clock forced on for the transfer.
+ */
+bool
+AppleCLCD::dsiKick(uint32_t size, bool lpm)
+{
 	uint32_t ctrl = dsi_rd(fDsi, 0x004), trig = dsi_rd(fDsi, 0x084);
+	uint32_t clk = dsi_rd(fDsi, 0x11c), dma = dsi_rd(fDsi, 0x03c), fifo = dsi_rd(fDsi, 0x050);
+	dsi_wr(fDsi, 0x11c, clk | 0x200b3fu);     /* DSI_CTRL_DYNAMIC_FORCE_ON */
 	if ((trig & 7) != 4) {
 		dsi_wr(fDsi, 0x084, (trig & ~7u) | 4);  /* DMA trigger: software */
 	}
 	dsi_wr(fDsi, 0x004, ctrl | 4 | 1);              /* CMD_MODE_EN | DSI_EN */
-	dsi_wr(fDsi, 0x110, dsi_rd(fDsi, 0x110) | 1);   /* clear CMD_DMA_DONE */
+	dsi_wr(fDsi, 0x110, (dsi_rd(fDsi, 0x110) & ~(1u << 24)) | 1);   /* clear CMD_DMA_DONE */
 	dsi_wr(fDsi, 0x15c, 0);                          /* no test pattern */
+	uint32_t d = dma;
+	d = lpm ? (d | (1u << 26)) : (d & ~(1u << 26));
+	d |= 1u << 28;
+	d &= ~((1u << 24) | (1u << 29) | (1u << 30) | (1u << 31));
+	dsi_wr(fDsi, 0x03c, d);
+	dsi_wr(fDsi, 0x050, fifo | (1u << 20) | (1u << 16));
 	dsi_wr(fDsi, 0x048, (uint32_t)fDsiBufPhys);
-	dsi_wr(fDsi, 0x04c, size);
-	uint32_t dma = dsi_rd(fDsi, 0x03c);
-	dsi_wr(fDsi, 0x03c, dma & ~(1u << 26));          /* high speed */
+	dsi_wr(fDsi, 0x04c, size & 0xffffffu);
 	dsi_wr(fDsi, 0x090, 1);                          /* SW trigger */
 	bool done = false;
 	for (int i = 0; i < 50 && !done; i++) {
@@ -778,12 +795,41 @@ AppleCLCD::dsiSend(const uint8_t hdr[4], const uint8_t *payload, uint32_t len)
 			IODelay(1000);
 		}
 	}
-	dsi_wr(fDsi, 0x110, dsi_rd(fDsi, 0x110) | 1);
+	if (!done) {
+		dsiDump(lpm ? "timeout lp" : "timeout hs");
+	}
+	dsi_wr(fDsi, 0x110, (dsi_rd(fDsi, 0x110) & ~(1u << 24)) | 1);
+	dsi_wr(fDsi, 0x050, fifo);
 	dsi_wr(fDsi, 0x03c, dma);
 	dsi_wr(fDsi, 0x004, ctrl);
 	if (trig != dsi_rd(fDsi, 0x084)) {
 		dsi_wr(fDsi, 0x084, trig);
 	}
+	dsi_wr(fDsi, 0x11c, clk);
+	return done;
+}
