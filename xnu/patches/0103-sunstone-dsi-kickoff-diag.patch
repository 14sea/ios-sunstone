+bool
+AppleCLCD::dsiSend(const uint8_t hdr[4], const uint8_t *payload, uint32_t len)
+{
+	if (fDsi == NULL || fDsiBuf == NULL || len > 60) {
+		return false;
+	}
+	uint8_t *p = (uint8_t *)fDsiBuf->getBytesNoCopy();
+	uint32_t size = (4 + len + 3) & ~3u;
+	memset(p, 0xff, 64);
+	memcpy(p, hdr, 4);
+	if (len) {
+		memcpy(p + 4, payload, len);
+	}
+	flush_dcache64((addr64_t)(uintptr_t)p, 64, FALSE);
+	static bool first = true;
+	if (first) {
+		first = false;
+		dsiDump("first cmd");
+	}
+	/* HS in the blanking first (topaz); this panel's own command tables are LP, try that too */
+	bool done = dsiKick(size, false) || dsiKick(size, true);
 	if (!done) {
 		fDsiOk = false;         /* back to the CPU fade for display off */
 	}
