+
+/* sweet_ufs.c found the record on userdata (after IOKit's calendar init): apply it unless a boot-arg says otherwise */
+extern "C" void
+sweet_rtc_offset_from_store(uint64_t offset, uint64_t raw)
+{
+	SweetPlatformExpert *pe = gSweetPE;
+	if (pe == NULL) {
+		return;
+	}
+	if (pe->fRTCOffsetFromArg) {
+		IOLog("SWEET RTC: stored offset %llu ignored, boot-arg sweetrtcoff=%llu\n", offset, pe->fRTCOffset);
+		return;
 	}
+	pe->fRTCOffset = offset;
+	uint32_t now = 0;
+	(void)sweet_rtc_read(&now);
+	IOLog("SWEET RTC: stored offset %llu (written at raw %llu), raw now %u: calendar -> %llu UTC\n",
+	    offset, raw, now, (uint64_t)now + offset);
+	clock_initialize_calendar();
