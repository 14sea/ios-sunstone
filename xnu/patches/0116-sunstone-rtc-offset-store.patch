+/*
+ * RTC offset record (sunstone, SweetPlatformExpert / sweet_rtc.c): the PMIC RTC
+ * counts from an arbitrary start, so the seconds to add for UTC live in the
+ * device block just below the log area:
+ *   "SWEETRTC" | u32 version 1 | u32 0 | u64 offset | u64 raw counter when written
+ * Written when iOS sets the time (setUTCTimeOfDay) and by tools/sweet-rtc-seed.sh
+ * from a recovery; boot-arg sweetrtcoff= overrides it.
+ */
+struct sweet_rtc_record {
+	char magic[8];
+	uint32_t version, pad;
+	uint64_t offset, raw;
+};
+
+int sweet_rtc_store_read(uint64_t *offset, uint64_t *raw);
+int sweet_rtc_store_write(uint64_t offset, uint64_t raw);
+extern void sweet_rtc_offset_from_store(uint64_t offset, uint64_t raw);  /* SweetPlatformExpert.cpp */
+
+static uint64_t
+sweet_rtc_block(void)
+{
+	return su.first_block + su.nblocks - SWEET_LOG_BLOCKS - 1;
+}
+
+int
+sweet_rtc_store_read(uint64_t *offset, uint64_t *raw)
+{
+	struct sweet_rtc_record r;
+	int error;
+
+	if (!su.ready || su.nblocks < 2 * SWEET_LOG_BLOCKS) {
+		return ENXIO;
+	}
+	lck_mtx_lock(&sweet_ufs_lock);
+	error = ufs_read_blocks(sweet_rtc_block(), 1);
+	if (!error) {
+		memcpy(&r, (void *)(su.dma + DMA_BOUNCE), sizeof(r));
+	}
+	lck_mtx_unlock(&sweet_ufs_lock);
+	if (error) {
+		return error;
+	}
+	if (memcmp(r.magic, "SWEETRTC", 8) != 0 || r.version != 1 || r.offset == 0) {
+		return ENOENT;
+	}
+	*offset = r.offset;
+	*raw = r.raw;
+	return 0;
+}
+
+int
+sweet_rtc_store_write(uint64_t offset, uint64_t raw)
+{
+	struct sweet_rtc_record r = {
+		.magic = { 'S', 'W', 'E', 'E', 'T', 'R', 'T', 'C' },
+		.version = 1, .pad = 0, .offset = offset, .raw = raw,
+	};
+	int error;
+
+	if (!su.ready || !su.writable || su.nblocks < 2 * SWEET_LOG_BLOCKS) {
+		return EROFS;
+	}
+	lck_mtx_lock(&sweet_ufs_lock);
+	bzero((void *)(su.dma + DMA_BOUNCE), UFS_BLOCK);
+	memcpy((void *)(su.dma + DMA_BOUNCE), &r, sizeof(r));
+	error = ufs_write_blocks(sweet_rtc_block(), 1);
+	if (!error) {
+		error = ufs_sync_cache();
+	}
+	lck_mtx_unlock(&sweet_ufs_lock);
+	printf("SWEET RTC: offset %llu stored at block 0x%llx (%d)\n", offset, sweet_rtc_block(), error);
+	return error;
+}
+
+static void
+sweet_rtc_store_boot(void)
+{
+	uint64_t offset = 0, raw = 0;
+
+	if (sweet_rtc_store_read(&offset, &raw) == 0) {
+		sweet_rtc_offset_from_store(offset, raw);
+	}
+}
+
