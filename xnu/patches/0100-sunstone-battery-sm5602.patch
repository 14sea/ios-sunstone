--- /dev/null
+++ b/bsd/dev/sweet_i2c1.c
@@ -0,0 +1,485 @@
+/*
+ * sunstone: polled I2C on QUPV3_WRAP1 S1 (qupv3_se7_i2c at 0x4c84000), the
+ * battery bus: SM5602 fuel gauge at 0x71 and the bq25890-map SC8989X charger
+ * at 0x6a (live DT 2026-10-21; the same chips as topaz, which has them on
+ * QUP0 SE1). Read-only use by SweetBattery: nothing is written to either chip.
+ *
+ * Two transports, chosen at init like the sunstone touch driver (SE8):
+ *  - GENI FIFO mode (topaz sweet_i2c1.c / Linux i2c-qcom-geni.c) when the SE
+ *    still has its FIFO interface;
+ *  - open-drain GPIO bit-bang on SDA/SCL GPIO27/28 when TrustZone loaded the
+ *    SE for GSI DMA only (GENI_IF_DISABLE_RO 0x64 bit 0 FIFO_IF_DISABLE), as
+ *    it does for SE8. ~100 kHz, clock stretching honoured.
+ * Clocks: WRAP1 S1 branch (bit 22) and the WRAP1 core/AHB votes in GCC
+ * 0x7900c, RCG 0x5314c from XO (gcc-sm6375.c). Pins: gpio27/28 function 1
+ * (qup11_f1, pinctrl-sm6375.c), 2 mA, pull-up (DT qupv3_se7_i2c_active).
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/locks.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+int sweet_i2c1_init(void);
+int sweet_i2c1_read(uint8_t addr, uint8_t reg, uint8_t *buf, unsigned len);
+
+#define I2C1_SE_PA      0x04c84000u     /* qupv3_se7_i2c = QUPV3_WRAP1 S1 */
+#define I2C1_GCC_PA     0x01400000u
+#define I2C1_TLMM_PA    0x00500000u     /* one tile (pinctrl-blair.c); GPIO n at n*0x1000 */
+#define I2C1_GCC_VOTE   0x7900cu
+#define I2C1_GCC_BITS   0x5e0000u       /* WRAP1 S1 22, M_AHB 17, S_AHB 18, CORE 19, CORE_2X 20 */
+#define I2C1_RCG        0x5314cu        /* WRAP1 S1 CMD_RCGR; CFG +4, CBCR -4 = 0x53148 */
+#define I2C1_PIN_SDA    27u
+#define I2C1_PIN_SCL    28u
+#define GPIO_CFG(n)     ((uint32_t)(n) * 0x1000u)
+#define GPIO_IO(n)      (GPIO_CFG(n) + 4u)
+
+#define SE_STATUS       0x040u
+#define SE_MCLK         0x048u
+#define SE_IF_DISABLE   0x064u
+#define SE_FW           0x068u
+#define SE_CLK_SEL      0x07cu
+#define SE_DMA          0x258u
+#define SE_TX_LEN       0x26cu
+#define SE_RX_LEN       0x270u
+#define SE_SCL          0x278u
+#define SE_CMD          0x600u
+#define SE_CTRL         0x604u
+#define SE_IRQ          0x610u
+#define SE_IRQ_EN       0x614u
+#define SE_IRQ_CLR      0x618u
+#define SE_TX           0x700u
+#define SE_RX           0x780u
+#define SE_TX_COUNT     0x800u
+#define SE_RX_COUNT     0x804u
+#define SE_TX_WM        0x80cu
+#define SE_HW_TX        0xe24u
+#define SE_HW_RX        0xe28u
+#define SE_DONE         (1u << 0)
+#define SE_NACK         (1u << 10)
+#define SE_TX_WM_IRQ    (1u << 30)
+#define SE_ERRORS       (0x3eu | (1u << 9) | (1u << 10) | (1u << 12) | (1u << 13))
+#define SE_PACK0        0x0007f8feu
+#define SE_PACK1        0x000ffefeu
+
+#define BB_HALF_US      5u
+#define BB_STRETCH_US   1000u
+
+static vm_offset_t i2c1_se, i2c1_gcc, i2c1_tlmm;
+static bool i2c1_ready, i2c1_bitbang, i2c1_bb_held;
+static LCK_GRP_DECLARE(sweet_i2c1_grp, "sweet_i2c1");
+static LCK_MTX_DECLARE(sweet_i2c1_lock, &sweet_i2c1_grp);
+
+static uint32_t
+rd(vm_offset_t b, uint32_t o)
+{
+	uint32_t v = *(volatile uint32_t *)(b + o);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+wr(vm_offset_t b, uint32_t o, uint32_t v)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(b + o) = v;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static bool
+wait_clear(vm_offset_t b, uint32_t o, uint32_t m)
+{
+	for (unsigned i = 0; i < 5000; ++i) {
+		if (!(rd(b, o) & m)) {
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+/* TLMM: mux/pull/drive and optional output latch (as sweet_touch.c touch_gpio). */
+static void
+gpio_cfg(unsigned pin, unsigned mux, unsigned pull, unsigned drive, bool out, bool high)
+{
+	uint32_t off = GPIO_CFG(pin);
+	uint32_t cfg = rd(i2c1_tlmm, off);
+	if (out) {
+		wr(i2c1_tlmm, GPIO_IO(pin), (rd(i2c1_tlmm, GPIO_IO(pin)) & ~2u) | (high ? 2u : 0u));
+	}
+	cfg &= ~0x3ffu;
+	cfg |= (mux << 2) | pull | (drive << 6) | (out ? 0x200u : 0u);
+	wr(i2c1_tlmm, off, cfg);
+}
+
+/* --- GPIO bit-bang (open drain: OUT latch 0, low = output enable) --- */
+
+static void
+bb_line(unsigned pin, bool low)
+{
+	uint32_t off = GPIO_CFG(pin);
+	uint32_t cfg = rd(i2c1_tlmm, off);
+	wr(i2c1_tlmm, off, low ? (cfg | 0x200u) : (cfg & ~0x200u));
+}
+
+static bool
+bb_get(unsigned pin)
+{
+	return (rd(i2c1_tlmm, GPIO_IO(pin)) & 1u) != 0;
+}
+
+static bool
+bb_scl_high(void)
+{
+	bb_line(I2C1_PIN_SCL, false);
+	for (unsigned i = 0; i < BB_STRETCH_US; i++) {
+		if (bb_get(I2C1_PIN_SCL)) {
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+static void
+bb_setup(void)
+{
+	/* plain GPIO (mux 0), pull-up, 6 mA when driving low, OUT latch 0 */
+	gpio_cfg(I2C1_PIN_SDA, 0, 3, 2, false, false);
+	gpio_cfg(I2C1_PIN_SCL, 0, 3, 2, false, false);
+	wr(i2c1_tlmm, GPIO_IO(I2C1_PIN_SDA), rd(i2c1_tlmm, GPIO_IO(I2C1_PIN_SDA)) & ~2u);
+	wr(i2c1_tlmm, GPIO_IO(I2C1_PIN_SCL), rd(i2c1_tlmm, GPIO_IO(I2C1_PIN_SCL)) & ~2u);
+	delay(BB_HALF_US);
+	/* bus recovery: up to 9 clocks while a slave holds SDA low, then STOP */
+	for (unsigned i = 0; i < 9 && !bb_get(I2C1_PIN_SDA); i++) {
+		bb_line(I2C1_PIN_SCL, true);
+		delay(BB_HALF_US);
+		(void)bb_scl_high();
+		delay(BB_HALF_US);
+	}
+	bb_line(I2C1_PIN_SDA, true);
+	delay(BB_HALF_US);
+	(void)bb_scl_high();
+	delay(BB_HALF_US);
+	bb_line(I2C1_PIN_SDA, false);
+	delay(BB_HALF_US);
+	i2c1_bb_held = false;
+	printf("SWEET I2C1: bit-bang I2C on GPIO%u/%u, idle sda=%d scl=%d\n", I2C1_PIN_SDA,
+	    I2C1_PIN_SCL, bb_get(I2C1_PIN_SDA), bb_get(I2C1_PIN_SCL));
+}
+
+static bool
+bb_start(bool repeated)
+{
+	if (repeated) {
+		bb_line(I2C1_PIN_SDA, false);
+		delay(BB_HALF_US);
+		if (!bb_scl_high()) {
+			return false;
+		}
+		delay(BB_HALF_US);
+	}
+	if (!bb_get(I2C1_PIN_SDA)) {
+		return false;           /* bus not free */
+	}
+	bb_line(I2C1_PIN_SDA, true);
+	delay(BB_HALF_US);
+	bb_line(I2C1_PIN_SCL, true);
+	delay(BB_HALF_US);
+	return true;
+}
+
+static void
+bb_stop(void)
+{
+	bb_line(I2C1_PIN_SDA, true);
+	delay(BB_HALF_US);
+	(void)bb_scl_high();
+	delay(BB_HALF_US);
+	bb_line(I2C1_PIN_SDA, false);
+	delay(BB_HALF_US);
+	i2c1_bb_held = false;
+}
+
+/* 0 on ACK, ENXIO on NACK, ETIMEDOUT if SCL stays low. */
+static int
+bb_write_byte(uint8_t b)
+{
+	for (int i = 7; i >= 0; i--) {
+		bb_line(I2C1_PIN_SDA, !((b >> i) & 1u));
+		delay(BB_HALF_US);
+		if (!bb_scl_high()) {
+			return ETIMEDOUT;
+		}
+		delay(BB_HALF_US);
+		bb_line(I2C1_PIN_SCL, true);
+	}
+	bb_line(I2C1_PIN_SDA, false);
+	delay(BB_HALF_US);
+	if (!bb_scl_high()) {
+		return ETIMEDOUT;
+	}
+	bool nack = bb_get(I2C1_PIN_SDA);
+	delay(BB_HALF_US);
+	bb_line(I2C1_PIN_SCL, true);
+	return nack ? ENXIO : 0;
+}
+
+static int
+bb_read_byte(uint8_t *out, bool ack)
+{
+	uint8_t b = 0;
+	bb_line(I2C1_PIN_SDA, false);
+	for (int i = 0; i < 8; i++) {
+		delay(BB_HALF_US);
+		if (!bb_scl_high()) {
+			return ETIMEDOUT;
+		}
+		b = (uint8_t)((b << 1) | (bb_get(I2C1_PIN_SDA) ? 1u : 0u));
+		delay(BB_HALF_US);
+		bb_line(I2C1_PIN_SCL, true);
+	}
+	bb_line(I2C1_PIN_SDA, ack);
+	delay(BB_HALF_US);
+	if (!bb_scl_high()) {
+		return ETIMEDOUT;
+	}
+	delay(BB_HALF_US);
+	bb_line(I2C1_PIN_SCL, true);
+	bb_line(I2C1_PIN_SDA, false);
+	*out = b;
+	return 0;
+}
+
+/* One write or one read; stretch = no STOP (repeated START for the read that follows). */
+static int
+bb_msg(uint8_t addr, const uint8_t *tx, unsigned nt, uint8_t *rx, unsigned nr, bool stretch)
+{
+	int err;
+	if (!bb_start(i2c1_bb_held)) {
+		bb_setup();
+		return EBUSY;
+	}
+	err = bb_write_byte((uint8_t)((addr << 1) | (nr ? 1u : 0u)));
+	if (err) {
+		goto stop;
+	}
+	for (unsigned i = 0; i < nt; i++) {
+		err = bb_write_byte(tx[i]);
+		if (err) {
+			err = err == ENXIO ? EIO : err;
+			goto stop;
+		}
+	}
+	for (unsigned i = 0; i < nr; i++) {
+		err = bb_read_byte(&rx[i], i + 1 < nr);
+		if (err) {
+			goto stop;
+		}
+	}
+	if (nt && stretch) {
+		i2c1_bb_held = true;
+		return 0;
+	}
+stop:
+	bb_stop();
+	if (err == ETIMEDOUT) {
+		bb_setup();
+	}
+	return err;
+}
+
+/* --- GENI FIFO mode --- */
+
+static void
+fifo_abort(void)
+{
+	wr(i2c1_se, SE_CTRL, 4);                /* cancel */
+	for (unsigned i = 0; i < 1000 && !(rd(i2c1_se, SE_IRQ) & (1u << 4)); ++i) {
+		delay(1);
+	}
+	if (!(rd(i2c1_se, SE_IRQ) & (1u << 4))) {
+		wr(i2c1_se, SE_CTRL, 2);        /* abort */
+		for (unsigned i = 0; i < 1000 && !(rd(i2c1_se, SE_IRQ) & (1u << 5)); ++i) {
+			delay(1);
+		}
+	}
+	for (unsigned i = 0; i < 64 && (rd(i2c1_se, SE_RX_COUNT) & 0x1ffffffu); ++i) {
+		(void)rd(i2c1_se, SE_RX);
+	}
+	wr(i2c1_se, SE_IRQ_CLR, 0xffffffffu);
+}
+
+/* One message: write nt (<= 3) bytes or read nr (<= 64) bytes. */
+static int
+fifo_msg(uint8_t addr, const uint8_t *tx, unsigned nt, uint8_t *rx, unsigned nr, bool stretch)
+{
+	unsigned sent = 0, got = 0;
+	if (!wait_clear(i2c1_se, SE_STATUS, 1u)) {
+		return EBUSY;
+	}
+	wr(i2c1_se, SE_IRQ_CLR, 0xffffffffu);
+	wr(i2c1_se, SE_TX_WM, nt ? 1u : 0u);
+	wr(i2c1_se, nr ? SE_RX_LEN : SE_TX_LEN, nr ? nr : nt);
+	wr(i2c1_se, SE_CMD, ((nr ? 2u : 1u) << 27) | ((uint32_t)addr << 9) | (stretch ? 4u : 0u));
+	for (unsigned i = 0; i < 20000; ++i) {
+		uint32_t irq = rd(i2c1_se, SE_IRQ);
+		if (irq & SE_ERRORS) {
+			int err = (irq & SE_NACK) ? ENXIO : EIO;
+			for (unsigned j = 0; j < 2000 && !(irq & SE_DONE); ++j) {
+				delay(1);
+				irq = rd(i2c1_se, SE_IRQ);
+			}
+			if (!(irq & SE_DONE) || (rd(i2c1_se, SE_STATUS) & 1u)) {
+				fifo_abort();
+			}
+			wr(i2c1_se, SE_IRQ_CLR, 0xffffffffu);
+			return err;
+		}
+		if (nt && !sent && (irq & SE_TX_WM_IRQ)) {
+			uint32_t word = 0;
+			for (unsigned j = 0; j < nt; ++j) {
+				word |= (uint32_t)tx[j] << (8u * j);
+			}
+			wr(i2c1_se, SE_TX, word);
+			sent = nt;
+			wr(i2c1_se, SE_TX_WM, 0);
+		}
+		uint32_t count = rd(i2c1_se, SE_RX_COUNT) & 0x1ffffffu;
+		if (count > 16) {
+			break;
+		}
+		while (count--) {
+			uint32_t word = rd(i2c1_se, SE_RX);
+			for (unsigned j = 0; j < 4 && got < nr; ++j) {
+				rx[got++] = (uint8_t)(word >> (8u * j));
+			}
+		}
+		if (irq & SE_DONE) {
+			wr(i2c1_se, SE_IRQ_CLR, 0xffffffffu);
+			return (got == nr && sent == nt) ? 0 : EIO;
+		}
+		wr(i2c1_se, SE_IRQ_CLR, irq & ~SE_DONE);
+		delay(1);
+	}
+	fifo_abort();
+	return ETIMEDOUT;
+}
+
+static int
+fifo_init(void)
+{
+	uint32_t fw = rd(i2c1_se, SE_FW);
+	uint32_t tx = rd(i2c1_se, SE_HW_TX), rxp = rd(i2c1_se, SE_HW_RX);
+	if (((fw >> 8) & 0xffu) != 3u || ((tx >> 24) & 0x3fu) != 32u || ((rxp >> 24) & 0x3fu) != 32u) {
+		printf("SWEET I2C1: SE7 is not an I2C engine (fw %#x tx %#x rx %#x)\n", fw, tx, rxp);
+		return EIO;
+	}
+	if (rd(i2c1_se, SE_STATUS) & 0x1001u) {
+		printf("SWEET I2C1: SE7 busy (status %#x)\n", rd(i2c1_se, SE_STATUS));
+		return EBUSY;
+	}
+	wr(i2c1_se, 0xe18, 0);
+	wr(i2c1_se, 0xe1c, 0);
+	wr(i2c1_se, 0x644, 0);
+	wr(i2c1_se, SE_IRQ_CLR, 0xffffffffu);
+	wr(i2c1_se, 0x648, 0xffffffffu);
+	wr(i2c1_se, SE_DMA, 0);
+	wr(i2c1_se, 0x28, rd(i2c1_se, 0x28) | 0x7fu);
+	wr(i2c1_se, 0xe30, rd(i2c1_se, 0xe30) | 0x0fu);
+	wr(i2c1_se, 0x24, 0x7f);
+	wr(i2c1_se, 0x20, 1);
+	wr(i2c1_se, SE_CLK_SEL, 0);
+	wr(i2c1_se, SE_MCLK, (2u << 4) | 1u);                  /* 400 kHz from 19.2 MHz */
+	wr(i2c1_se, SE_SCL, (5u << 20) | (11u << 10) | 22u);
+	wr(i2c1_se, 0x254, 0);
+	wr(i2c1_se, 0x260, SE_PACK0);
+	wr(i2c1_se, 0x264, SE_PACK1);
+	wr(i2c1_se, 0x284, SE_PACK0);
+	wr(i2c1_se, 0x288, SE_PACK1);
+	wr(i2c1_se, SE_TX_WM, 0);
+	wr(i2c1_se, 0x810, 0);
+	wr(i2c1_se, 0x814, ((rxp >> 16) & 0x3fu) - 1u);
+	wr(i2c1_se, SE_IRQ_EN, SE_DONE | SE_ERRORS | (3u << 26) | SE_TX_WM_IRQ);
+	if (rd(i2c1_se, 0x260) != SE_PACK0 || rd(i2c1_se, 0x284) != SE_PACK0) {
+		printf("SWEET I2C1: packing readback mismatch\n");
+		return EIO;
+	}
+	/* qup11_f1 on GPIO27/28: function 1, 2 mA, pull-up (DT) */
+	gpio_cfg(I2C1_PIN_SDA, 1, 3, 0, false, false);
+	gpio_cfg(I2C1_PIN_SCL, 1, 3, 0, false, false);
+	printf("SWEET I2C1: SE7 FIFO ready (fw %#x)\n", fw);
+	return 0;
+}
+
+int
+sweet_i2c1_read(uint8_t addr, uint8_t reg, uint8_t *buf, unsigned len)
+{
+	if (!i2c1_ready || len == 0 || len > 64) {
+		return ENXIO;
+	}
+	lck_mtx_lock(&sweet_i2c1_lock);
+	int err;
+	if (i2c1_bitbang) {
+		err = bb_msg(addr, &reg, 1, NULL, 0, true);
+		if (!err) {
+			err = bb_msg(addr, NULL, 0, buf, len, false);
+		}
+	} else {
+		err = fifo_msg(addr, &reg, 1, NULL, 0, true);
+		if (!err) {
+			err = fifo_msg(addr, NULL, 0, buf, len, false);
+		}
+	}
+	lck_mtx_unlock(&sweet_i2c1_lock);
+	return err;
+}
+
+int
+sweet_i2c1_init(void)
+{
+	if (i2c1_ready) {
+		return 0;
+	}
+	i2c1_gcc = ml_io_map(I2C1_GCC_PA, 0x80000);
+	i2c1_tlmm = ml_io_map(I2C1_TLMM_PA, 0x58000);          /* GPIO 0..87 */
+	i2c1_se = ml_io_map(I2C1_SE_PA, 0x4000);
+	if (!i2c1_gcc || !i2c1_tlmm || !i2c1_se) {
+		return ENOMEM;
+	}
+	/* OR our votes in: other bits of the shared register belong to others. XO, divider 1. */
+	wr(i2c1_gcc, I2C1_GCC_VOTE, rd(i2c1_gcc, I2C1_GCC_VOTE) | I2C1_GCC_BITS);
+	printf("SWEET I2C1: gcc vote=%#x rcg=%#x cfg=%#x cbcr=%#x\n",
+	    rd(i2c1_gcc, I2C1_GCC_VOTE), rd(i2c1_gcc, I2C1_RCG),
+	    rd(i2c1_gcc, I2C1_RCG + 4u), rd(i2c1_gcc, I2C1_RCG - 4u));
+	wr(i2c1_gcc, I2C1_RCG + 4u, 1u);
+	wr(i2c1_gcc, I2C1_RCG, rd(i2c1_gcc, I2C1_RCG) | 1u);
+	if (!wait_clear(i2c1_gcc, I2C1_RCG, 1u)) {
+		printf("SWEET I2C1: RCG update timeout\n");
+		return EIO;
+	}
+	if (!wait_clear(i2c1_gcc, I2C1_RCG - 4u, 1u << 31)) {
+		printf("SWEET I2C1: SE7 branch halted (cbcr %#x)\n", rd(i2c1_gcc, I2C1_RCG - 4u));
+		return EIO;
+	}
+	uint32_t fw = rd(i2c1_se, SE_FW);
+	printf("SWEET I2C1: se7 fw=%#x proto=%u status=%#x ifdis=%#x\n", fw, (fw >> 8) & 0xffu,
+	    rd(i2c1_se, SE_STATUS), rd(i2c1_se, SE_IF_DISABLE));
+	if (((fw >> 8) & 0xffu) == 3u && (rd(i2c1_se, SE_IF_DISABLE) & 1u)) {
+		printf("SWEET I2C1: SE7 FIFO interface disabled (GSI-only); I2C by GPIO bit-bang\n");
+		i2c1_bitbang = true;
+		bb_setup();
+	} else {
+		int err = fifo_init();
+		if (err) {
+			return err;
+		}
+	}
+	i2c1_ready = true;
+	return 0;
+}
