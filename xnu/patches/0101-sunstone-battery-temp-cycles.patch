+/*
+ * SM5602 TEMPERATURE_EX (0x0A): thermistor reading looked up in the battery's
+ * table from the stock DT (battery0,thermal_table, 101 entries for -20..80 C,
+ * identical for battery0/1/2). sm5602_fg.c _calculate_battery_temp_ex().
+ */
+static const int16_t sweet_sm5602_temp_table[101] = {
+	 15162,  13590,  12037,  10484,   8995,   7552,   6148,   4833,
+	  3495,   2227,    982,  -2318,  -3469,  -4605,  -5680,  -6713,
+	 -7710,  -8660,  -9576, -10457, -11304, -12110, -12884, -13624,
+	-14330, -15012, -15664, -16279, -16873, -17439, -17978, -18496,
+	-18989, -19456, -19902, -20334, -20739, -21124, -21498, -21850,
+	-22189, -22508, -22818, -23106, -23387, -23652, -23903, -24143,
+	-24373, -24589, -24797, -24999, -25190, -25369, -25541, -25707,
+	-25865, -26014, -26158, -26293, -26421, -26546, -26666, -26779,
+	-26886, -26989, -27087, -27181, -27271, -27357, -27441, -27519,
+	-27595, -27668, -27738, -27804, -27867, -27926, -27983, -28037,
+	-28091, -28142, -28191, -28238, -28283, -28326, -28366, -28405,
+	-28442, -28478, -28512, -28546, -28578, -28608, -28638, -28666,
+	-28694, -28720, -28745, -28768, -28790,
+};
+
+static int
+sweet_sm5602_temp_c(uint16_t raw)
+{
+	if (raw >= 0x8001 && raw <= 0x823b) {
+		raw = 0;
+	}
+	int16_t val = (int16_t)raw;
+	if (val >= sweet_sm5602_temp_table[0]) {
+		return -20;
+	}
+	if (val <= sweet_sm5602_temp_table[100]) {
+		return 80;
+	}
+	for (int i = 0; i < 101; i++) {
+		if (val >= sweet_sm5602_temp_table[i]) {
+			int t = -20 + i;
+			if (t >= 1 && val != sweet_sm5602_temp_table[i]) {
+				t--;
+			}
+			return t;
+		}
+	}
+	return 25;
+}
