+		A6XX_PROT_RW(0x00900, 0x004d),
+		A6XX_PROT_RW(0x0098d, 0x0272),
+		A6XX_PROT_RW(0x00e00, 0x0001),
+		A6XX_PROT_RW(0x00e03, 0x000c),
+		A6XX_PROT_RW(0x03c00, 0x00c3),
+		A6XX_PROT_RO(0x03cc4, 0x1fff),
+		A6XX_PROT_RW(0x08630, 0x01cf),
+		A6XX_PROT_RW(0x08e00, 0x0000),
+		A6XX_PROT_RW(0x08e08, 0x0000),
+		A6XX_PROT_RW(0x08e50, 0x001f),
+		A6XX_PROT_RW(0x09624, 0x01db),
+		A6XX_PROT_RW(0x09e70, 0x0001),
+		A6XX_PROT_RW(0x09e78, 0x0187),
+		A6XX_PROT_RW(0x0a630, 0x01cf),
