+static void
+smmu_detach(uint32_t *fsr_out, uint64_t *far_out, uint32_t *syn_out)
+{
+	uint32_t fsr = smmu_rd(gpu_cb0, SMMU_CB0_FSR);
+	if (fsr_out != NULL) {
+		*fsr_out = fsr;
+	}
+	if ((fsr & 0x3feu) != 0) {
+		uint32_t far_lo = smmu_rd(gpu_cb0, 0x60);
+		uint32_t far_hi = smmu_rd(gpu_cb0, 0x64);
+		uint32_t syn = smmu_rd(gpu_cb0, 0x68);
+		if (far_out != NULL) {
+			*far_out = ((uint64_t)far_hi << 32) | far_lo;
+		}
+		if (syn_out != NULL) {
+			*syn_out = syn;
+		}
+		/* If SS (bit 30) somehow set, terminate stalled transaction via CB0_RESUME. */
+		if ((fsr & (1u << 30)) != 0) {
+			smmu_wr(gpu_cb0, 0x08, 1u);     /* SMMU_CB0_RESUME: TnR=1 (terminate) */
+		}
+		smmu_wr(gpu_cb0, SMMU_CB0_FSR, 0xffffffffu);
+	}
+	smmu_wr(gpu_smmu, 0x48, 0xffffffffu);   /* clear global GFSR */
+	smmu_wr(gpu_cb0, 0x00, SMMU_SCTLR_BYPASS); /* M=0, CFCFG=0: bypass for kernel display copies */
+	smmu_wr(gpu_cb0, 0x20, 0u);
+	smmu_wr(gpu_cb0, 0x24, 0u);
+	__builtin_arm_dsb(0xf);
+	smmu_tlb_sync();
+}
