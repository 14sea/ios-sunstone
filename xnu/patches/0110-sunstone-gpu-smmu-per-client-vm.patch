+static void
+smmu_attach(struct sweet_gpu_vm *vm)
+{
+	smmu_wr(gpu_smmu, 0x48, 0xffffffffu);   /* clear global GFSR */
+	smmu_wr(gpu_cb0, SMMU_CB0_FSR, 0xffffffffu);    /* clear CB0_FSR */
+	smmu_wr(gpu_cb0, 0x00, SMMU_SCTLR_BYPASS); /* M=0, CFCFG=0 while programming CB0 */
+	__builtin_arm_dsb(0xf);
+	smmu_wr(gpu_gr1, 0x800, 1u);            /* CBA2R0: VA64 */
+	smmu_wr(gpu_gr1, 0x000, 0x0001f000u);   /* CBAR0: stage 1, stage 2 bypass */
+	smmu_wr(gpu_cb0, 0x38, 0x0004ff44u);    /* MAIR0: attr0=NC(0x44), attr1=WB(0xff), attr2=Dev(0x04) */
+	smmu_wr(gpu_cb0, 0x3c, 0u);             /* MAIR1 */
+	smmu_wr(gpu_cb0, 0x30, (1u << 23) | 25u); /* TCR: EPD1=1, TG0=4KB, T0SZ=25 (39-bit VA) */
+	smmu_wr(gpu_cb0, 0x10, (7u << 15) | 2u);  /* TCR2: SEP=7, PASize=2 (40-bit PA) */
+	smmu_wr(gpu_cb0, 0x20, (uint32_t)vm->l1_pa);
+	smmu_wr(gpu_cb0, 0x24, (uint32_t)(vm->l1_pa >> 32) | ((uint32_t)vm->asid << 16));
+	__builtin_arm_dsb(0xf);
+	smmu_tlb_sync();
+	/* SCTLR = 0x12f: HUPCF(8) | CFRE(5) | AFFD(3) | AFE(2) | TRE(1) | M(0); CFCFG(7)=0 */
+	smmu_wr(gpu_cb0, 0x00, SMMU_SCTLR_STAGE1);
+	__builtin_arm_dsb(0xf);
+}
