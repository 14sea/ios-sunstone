+/*
+ * Check that a staged IB only contains safe PM4 packets and context/2D/3D
+ * register writes (no privileged CP/SMMU/SECVID/RBBM control writes, no
+ * unvalidated indirect draw state streams, and no nested IBs).
+ */
+static bool
+reg_allowed(uint32_t reg)
+{
+	return (reg >= 0x8000 && reg <= 0xbfff) ||
+	       (reg >= 0x0c00 && reg <= 0x0dff) ||
+	       (reg >= 0x0883 && reg <= 0x088a);
+}
+
+bool
+sweet_gpu_check_ib(const uint32_t *ib, uint32_t dwords)
+{
+	if (ib == NULL || dwords == 0 || dwords > SWEET_GPU_MAX_IB_DWORDS) {
+		return false;
+	}
+	uint32_t i = 0;
+	while (i < dwords) {
+		uint32_t hdr = ib[i++];
+		uint32_t type = hdr >> 28;
+		if (type == 4) {
+			uint32_t cnt = hdr & 0x7fu;
+			uint32_t reg = (hdr >> 8) & 0x3ffffu;
+			if (cnt == 0 || i + cnt > dwords) {
+				return false;
+			}
+			for (uint32_t k = 0; k < cnt; k++) {
+				if (!reg_allowed(reg + k)) {
+					return false;
+				}
+			}
+			i += cnt;
+		} else if (type == 7) {
+			uint32_t cnt = hdr & 0x7fffu;
+			uint32_t op = (hdr >> 16) & 0x7fu;
+			if (i + cnt > dwords) {
+				return false;
+			}
+			switch (op) {
+			case CP_NOP:
+			case CP_WAIT_FOR_ME:
+			case CP_SKIP_IB2_ENABLE_GLOBAL:
+			case CP_REG_RMW:
+			case CP_SKIP_IB2_ENABLE_LOCAL:
+			case CP_WAIT_FOR_IDLE:
+			case CP_BLIT:
+			case CP_SET_BIN_DATA5:
+			case CP_LOAD_STATE6:
+			case CP_LOAD_STATE6_GEOM:
+			case CP_EXEC_CS:
+			case CP_LOAD_STATE6_FRAG:
+			case CP_SET_SUBDRAW_SIZE:
+			case CP_DRAW_INDX_OFFSET:
+			case CP_WAIT_REG_MEM:
+			case CP_MEM_WRITE:
+			case CP_REG_TO_MEM:
+			case CP_EXEC_CS_INDIRECT:
+			case CP_EVENT_WRITE:
+			case CP_SET_VISIBILITY_OVERRIDE:
+			case CP_SET_MARKER:
+			case CP_MEM_TO_MEM:
+				if (op == CP_REG_RMW && (cnt < 3 || !reg_allowed(ib[i] & 0x3ffffu))) {
+					return false;
+				}
+				break;
+			case CP_SET_DRAW_STATE:
+				/*
+				 * Each draw state group entry is 3 dwords (cmd, iova_lo, iova_hi).
+				 * Register writes inside SDS groups are enforced in hardware by
+				 * CP_PROTECT (programmed in gpu_init_cp_protect).
+				 */
+				if (cnt == 0 || (cnt % 3u) != 0) {
+					return false;
+				}
+				break;
+			case CP_CONTEXT_REG_BUNCH:
+				if ((cnt & 1u) != 0) {
+					return false;
+				}
+				for (uint32_t k = 0; k < cnt; k += 2) {
+					if (!reg_allowed(ib[i + k])) {
+						return false;
+					}
+				}
+				break;
+			default:
+				/* Reject CP_SMMU_TABLE_UPDATE, CP_SET_SECURE_MODE, CP_ME_INIT, nested IBs, etc. */
+				return false;
+			}
+			i += cnt;
+		} else {
+			return false;
+		}
+	}
+	return true;
+}
+
+bool
+sweet_gpu_vm_stage_ib(struct sweet_gpu_vm *vm, const uint32_t *src_kva, uint32_t dwords)
+{
+	if (vm == NULL || vm->ib_va == NULL || src_kva == NULL ||
+	    dwords == 0 || dwords > SWEET_GPU_MAX_IB_DWORDS) {
+		return false;
+	}
+	uint32_t bytes = dwords * 4u;
+	memcpy(vm->ib_va, src_kva, bytes);
+	if (!sweet_gpu_check_ib(vm->ib_va, dwords)) {
+		bzero(vm->ib_va, bytes);
+		return false;
+	}
+	sweet_gpu_clean_va((uintptr_t)vm->ib_va, bytes, false);
+	return true;
+}
