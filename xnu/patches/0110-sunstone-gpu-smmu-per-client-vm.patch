+/*
+ * Plain 32-bit LDR/STR for the GPU SMMU (Gunyah hypervisor emulation trap).
+ */
+static inline uint32_t
+smmu_rd(uintptr_t b, uint32_t o)
+{
+	uint32_t v;
+	__asm__ volatile ("ldr %w0, [%1]" : "=r"(v) : "r"(b + o) : "memory");
+	return v;
+}
+
+static inline void
+smmu_wr(uintptr_t b, uint32_t o, uint32_t v)
+{
+	__asm__ volatile ("str %w0, [%1]" : : "rZ"(v), "r"(b + o) : "memory");
+}
