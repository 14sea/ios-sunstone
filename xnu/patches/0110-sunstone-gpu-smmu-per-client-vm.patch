+	vm->n_sub++;
+	*pa_out = base_pa + (uint64_t)sub_idx * 0x1000ULL;
+	return (uint64_t *)((uintptr_t)md->getBytesNoCopy() + (uintptr_t)sub_idx * 0x1000u);
+}
+
+struct sweet_gpu_vm *
+sweet_gpu_vm_create(uint16_t asid)
+{
+	struct sweet_gpu_vm *vm = (struct sweet_gpu_vm *)IOMallocZeroData(sizeof(*vm));
+	if (vm == NULL) {
+		return NULL;
+	}
+	vm->asid = asid != 0 ? asid : 1;
+
+	uint64_t l2_user_pa = 0, l2_kern_pa = 0, l3_kern_pa = 0;
+	uint64_t *l2_kern_va = NULL, *l3_kern_va = NULL;
+	vm->l1_va = vm_alloc_table(vm, &vm->l1_pa);
+	vm->l2_user_va = vm_alloc_table(vm, &l2_user_pa);
+	l2_kern_va = vm_alloc_table(vm, &l2_kern_pa);
+	l3_kern_va = vm_alloc_table(vm, &l3_kern_pa);
+	vm->fence_va = (volatile uint32_t *)vm_alloc_table(vm, &vm->fence_pa);
+	vm->ib_mem = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task,
+	    kIODirectionInOut, GPU_USER_IB_BYTES, page_size);
+	if (vm->l1_va == NULL || vm->l2_user_va == NULL || l2_kern_va == NULL ||
+	    l3_kern_va == NULL || vm->fence_va == NULL || vm->ib_mem == NULL) {
+		sweet_gpu_vm_destroy(vm);
+		return NULL;
+	}
+	vm->ib_va = (uint32_t *)vm->ib_mem->getBytesNoCopy();
+	bzero(vm->ib_va, GPU_USER_IB_BYTES);
+	sweet_gpu_clean_va((uintptr_t)vm->ib_va, GPU_USER_IB_BYTES, false);
+
+	/* L1[0] covers user IOVAs [0x00000000, 0x40000000); L1[3] covers 0xe0000000..0xe01fffff */
+	vm->l1_va[0] = (l2_user_pa & SMMU_PA_MASK) | SMMU_PTE_PAGE;
+	vm->l1_va[(GPU_LOW_PHYS >> 30) & 0x1ff] = (l2_kern_pa & SMMU_PA_MASK) | SMMU_PTE_PAGE;
+	l2_kern_va[(GPU_LOW_PHYS >> 21) & 0x1ff] = (l3_kern_pa & SMMU_PA_MASK) | SMMU_PTE_PAGE;
+
+	/*
+	 * 1. Map CP ring (0xe0000000, 32 KB) and SQE microcode (0xe0010000, 64 KB) Read-Only.
+	 * 2. Map this client's private 4 KB fence page at GPU_USER_FENCE_IOVA (0xe0030000) Read-Write;
+	 *    the kernel's own gpu_ctl page (PA 0xe0020000) is NEVER mapped into any client VM.
+	 * 3. Map this client's kernel-only shadow IB buffer at GPU_USER_IB_IOVA (0xe0080000) Read-Only.
+	 */
+	for (uint32_t off = 0; off < GPU_RING_BYTES; off += 0x1000) {
+		uint64_t pa = GPU_RING_PHYS + off;
+		l3_kern_va[(pa >> 12) & 0x1ff] = (pa & SMMU_PA_MASK) |
+		    SMMU_PTE_AF | SMMU_PTE_SH_OS | SMMU_PTE_AP_RO | SMMU_PTE_ATTR_NC | SMMU_PTE_PAGE;
+	}
+	for (uint32_t off = 0; off < GPU_SQE_BYTES; off += 0x1000) {
+		uint64_t pa = GPU_SQE_PHYS + off;
+		l3_kern_va[(pa >> 12) & 0x1ff] = (pa & SMMU_PA_MASK) |
+		    SMMU_PTE_AF | SMMU_PTE_SH_OS | SMMU_PTE_AP_RO | SMMU_PTE_ATTR_NC | SMMU_PTE_PAGE;
+	}
+	l3_kern_va[(GPU_USER_FENCE_IOVA >> 12) & 0x1ff] = (vm->fence_pa & SMMU_PA_MASK) |
+	    SMMU_PTE_NG | SMMU_PTE_AF | SMMU_PTE_SH_OS | SMMU_PTE_AP_RW | SMMU_PTE_ATTR_NC | SMMU_PTE_PAGE;
+
+	for (uint32_t off = 0; off < GPU_USER_IB_BYTES; off += 0x1000) {
+		IOByteCount seg = 0;
+		addr64_t pa = vm->ib_mem->getPhysicalSegment(off, &seg, kIOMemoryMapperNone);
+		if (pa == 0) {
+			sweet_gpu_vm_destroy(vm);
+			return NULL;
+		}
+		uint64_t va = GPU_USER_IB_IOVA + off;
+		l3_kern_va[(va >> 12) & 0x1ff] = (pa & SMMU_PA_MASK) |
+		    SMMU_PTE_NG | SMMU_PTE_AF | SMMU_PTE_SH_OS | SMMU_PTE_AP_RO | SMMU_PTE_ATTR_NC | SMMU_PTE_PAGE;
+	}
+
+	sweet_gpu_clean_va((uintptr_t)vm->pt_pages[0]->getBytesNoCopy(), page_size, false);
+	if (vm->n_pages > 1) {
+		sweet_gpu_clean_va((uintptr_t)vm->pt_pages[1]->getBytesNoCopy(), page_size, false);
+	}
+	return vm;
+}
+
+void
+sweet_gpu_vm_destroy(struct sweet_gpu_vm *vm)
+{
+	if (vm == NULL) {
+		return;
+	}
+	OSSafeReleaseNULL(vm->ib_mem);
+	for (uint32_t i = 0; i < vm->n_pages; i++) {
+		OSSafeReleaseNULL(vm->pt_pages[i]);
+	}
+	IOFreeData(vm, sizeof(*vm));
+}
+
+bool
+sweet_gpu_vm_map(struct sweet_gpu_vm *vm, uint64_t iova,
+    IOMemoryDescriptor *mem, uint64_t offset, uint32_t size, bool writable)
+{
+	if (vm == NULL || mem == NULL || size == 0 || (iova & 0xfff) != 0 || (size & 0xfff) != 0 ||
+	    iova < SWEET_GPU_IOVA_BASE || iova + size > SWEET_GPU_IOVA_END || iova + size < iova) {
+		return false;
+	}
+	IOByteCount mem_len = mem->getLength();
+	uint64_t prot = writable ? SMMU_PTE_AP_RW : SMMU_PTE_AP_RO;
+	for (uint32_t off = 0; off < size; off += 0x1000) {
+		if (offset + off >= mem_len) {
+			sweet_gpu_vm_unmap(vm, iova, off);
+			return false;
+		}
+		uint64_t va = iova + off;
+		uint32_t l2_idx = (uint32_t)((va >> 21) & 0x1ff);
+		uint32_t l3_idx = (uint32_t)((va >> 12) & 0x1ff);
+		if (vm->l3_va[l2_idx] == NULL) {
+			uint64_t l3_pa = 0;
+			uint64_t *l3_va = vm_alloc_table(vm, &l3_pa);
+			if (l3_va == NULL) {
+				sweet_gpu_vm_unmap(vm, iova, off);
+				return false;
+			}
+			vm->l3_va[l2_idx] = l3_va;
+			vm->l2_user_va[l2_idx] = (l3_pa & SMMU_PA_MASK) | SMMU_PTE_PAGE;
+			sweet_gpu_clean_va((uintptr_t)&vm->l2_user_va[l2_idx], sizeof(uint64_t), false);
+		}
+		IOByteCount seg = 0;
+		addr64_t pa = mem->getPhysicalSegment(offset + off, &seg, kIOMemoryMapperNone);
+		/* Allow the tail of a wrapped client descriptor to be < 4 KB as long as the page PA is valid. */
+		if (pa == 0 || (pa & 0xfff) != 0 || seg == 0) {
+			sweet_gpu_vm_unmap(vm, iova, off);
+			return false;
+		}
+		vm->l3_va[l2_idx][l3_idx] = (pa & SMMU_PA_MASK) |
+		    SMMU_PTE_NG | SMMU_PTE_AF | SMMU_PTE_SH_OS | prot | SMMU_PTE_ATTR_NC | SMMU_PTE_PAGE;
+	}
+	uint32_t l2_first = (uint32_t)((iova >> 21) & 0x1ff);
+	uint32_t l2_last = (uint32_t)(((iova + size - 1) >> 21) & 0x1ff);
+	for (uint32_t l2 = l2_first; l2 <= l2_last; l2++) {
+		if (vm->l3_va[l2] != NULL) {
+			sweet_gpu_clean_va((uintptr_t)vm->l3_va[l2], 0x1000, false);
+		}
+	}
 	return true;
 }
 
+void
+sweet_gpu_vm_unmap(struct sweet_gpu_vm *vm, uint64_t iova, uint32_t size)
+{
+	if (vm == NULL || size == 0 || (iova & 0xfff) != 0 || (size & 0xfff) != 0 ||
+	    iova < SWEET_GPU_IOVA_BASE || iova + size > SWEET_GPU_IOVA_END) {
+		return;
+	}
+	for (uint32_t off = 0; off < size; off += 0x1000) {
+		uint64_t va = iova + off;
+		uint32_t l2_idx = (uint32_t)((va >> 21) & 0x1ff);
+		uint32_t l3_idx = (uint32_t)((va >> 12) & 0x1ff);
+		if (vm->l3_va[l2_idx] != NULL) {
+			vm->l3_va[l2_idx][l3_idx] = 0;
+		}
+	}
+	uint32_t l2_first = (uint32_t)((iova >> 21) & 0x1ff);
+	uint32_t l2_last = (uint32_t)(((iova + size - 1) >> 21) & 0x1ff);
+	for (uint32_t l2 = l2_first; l2 <= l2_last; l2++) {
+		if (vm->l3_va[l2] != NULL) {
+			sweet_gpu_clean_va((uintptr_t)vm->l3_va[l2], 0x1000, false);
+		}
+	}
+}
