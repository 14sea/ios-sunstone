+	if (page_idx >= SMMU_MAX_PT_PAGES) {
+		return NULL;
+	}
+	if (sub_idx == 0) {
+		IOBufferMemoryDescriptor *md = IOBufferMemoryDescriptor::inTaskWithOptions(
+		    kernel_task, kIODirectionInOut, page_size, page_size);
+		if (md == NULL) {
+			return NULL;
+		}
