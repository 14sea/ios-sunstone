+/* ---- Per-process SMMU stage-1 page tables (4 KB granule, 39-bit VA) ---- */
+
+static void
+smmu_tlb_sync(void)
+{
+	if (gpu_cb0 == 0) {
+		return;
+	}
+	__builtin_arm_dsb(0xf);
+	smmu_wr(gpu_cb0, 0x618, 0);             /* SMMU_CB0_TLBIALL (0x618, not 0x600 TLBIVA) */
+	smmu_wr(gpu_cb0, 0x7f0, 0);             /* SMMU_CB0_TLBSYNC */
+	__builtin_arm_dsb(0xf);
+	for (int i = 0; i < 1000; i++) {
+		if ((smmu_rd(gpu_cb0, 0x7f4) & 1u) == 0) {
+			break;
+		}
+		IODelay(1);
+	}
+}
