-			if (frame[0] <= fp) {
-				break;
+		if (ss != NULL && is_saved_state64(ss)) {
+			fp = get_saved_state_fp(ss);
+			n = snprintf(line, sizeof(line), "SMP %s t%d pc 0x%llx lr 0x%llx sp 0x%llx bt", name, t,
+			    get_saved_state_pc(ss), get_saved_state_lr(ss), get_saved_state_sp(ss));
+			for (int i = 0; !in_kernel && i < 16 && fp != 0 && (fp & 7) == 0 && n < (int)sizeof(line) - 20; i++) {
+				uint64_t frame[2];
