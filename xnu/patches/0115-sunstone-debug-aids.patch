 int sweet_console_muted;
+
+/*
+ * Boot-arg sweetcons=WORD,WORD,...: only console lines containing one of the
+ * words are drawn (a panic always is); everything still reaches the
+ * persistent log. (topaz 0112, there as sweetlog=WORDS; here sweetlog=0/1
+ * keeps its sweet meaning, the persistent log switch.)
+ */
+static char sweet_cons_words[128];
+static int sweet_cons_filter = -1;
+static char sweet_cons_line[256];
+static int sweet_cons_len;
+
+static bool
+sweet_cons_wanted(const char *line, int len)
+{
+	const char *w = sweet_cons_words;
+
+	while (*w) {
+		const char *end = w;
+		while (*end && *end != ',') {
+			end++;
+		}
+		int wl = (int)(end - w);
+		for (int i = 0; wl > 0 && i + wl <= len; i++) {
+			if (strncmp(line + i, w, wl) == 0) {
+				return true;
+			}
+		}
+		w = *end ? end + 1 : end;
+	}
+	return false;
+}
