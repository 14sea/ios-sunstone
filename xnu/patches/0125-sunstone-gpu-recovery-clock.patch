@@ -0,0 +1,372 @@
+/*
+ * sunstone-only, polled RPM GLINK client. Included by SweetGPU.cpp.
+ * Protocol references: Linux qcom_glink_rpm.c, qcom_glink_native.c, smd-rpm.c,
+ * rpmpd.c; live sunstone DT: RPM RAM 0x45f0000/0x7000, IPCC client 0 signal 0,
+ * rwgx:0 (pm6125_s8_level). Topaz's shared rwcx rail is NOT sunstone's GX.
+ * No interrupt handler, sleep votes, re-handshake, or direct PMIC writes.
+ */
+struct gpu_rpm_fifo { uint32_t off, size; };
+struct gpu_rpm_link {
+	uintptr_t ram, ipc;
+	struct gpu_rpm_fifo tx, rx;
+	uint32_t msgid, ack;
+	uint16_t rcid;
+	bool version, open, remote, error;
+};
+static struct gpu_rpm_link gpu_rpm;
+static IOMemoryMap *gpu_rpm_map, *gpu_ipcc_map, *gpu_cc_map;
+
+static bool
+gpu_rpm_indices(struct gpu_rpm_fifo f, uint32_t *tail, uint32_t *head)
+{
+	*tail = smmu_rd(gpu_rpm.ram, f.off);
+	*head = smmu_rd(gpu_rpm.ram, f.off + 4);
+	return *tail < f.size && *head < f.size && ((*tail | *head) & 3) == 0;
+}
+
+static bool
+gpu_rpm_send(const uint32_t *msg, uint32_t bytes)
+{
+	uint32_t tail, head;
+	if ((bytes & 7) || !gpu_rpm_indices(gpu_rpm.tx, &tail, &head)) {
+		return false;
+	}
+	uint32_t free = tail <= head ? gpu_rpm.tx.size - head + tail : tail - head;
+	if (bytes + 8 > free) { /* GLINK reserves 8 bytes so full never equals empty. */
+		return false;
+	}
+	for (uint32_t i = 0; i < bytes / 4; i++) {
+		smmu_wr(gpu_rpm.ram, gpu_rpm.tx.off + 8 + head, msg[i]);
+		head = (head + 4) % gpu_rpm.tx.size;
+	}
+	__builtin_arm_dsb(0xf);
+	smmu_wr(gpu_rpm.ram, gpu_rpm.tx.off + 4, head);
+	__builtin_arm_dsb(0xf);
+	smmu_wr(gpu_rpm.ipc, 0x0c, 0); /* IPCC SEND_ID = (AOP=0 << 16) | GLINK=0 */
+	return true;
+}
+
+static bool
+gpu_rpm_cmd(uint16_t cmd, uint16_t p1, uint32_t p2)
+{
+	uint32_t msg[] = {cmd | ((uint32_t)p1 << 16), p2};
+	return gpu_rpm_send(msg, sizeof(msg));
+}
+
+/* A complete RPM reply must acknowledge THIS msg#, and contain no error TLV. */
+static bool
+gpu_rpm_reply(const uint32_t *p, uint32_t bytes)
+{
+	if (bytes < 8 || p[0] != 0x00716572 || p[1] != bytes - 8) {
+		return false;
+	}
+	uint32_t id = 0;
+	bool error = false;
+	for (uint32_t off = 8; off < bytes;) {
+		if (bytes - off < 8) {
+			return false;
+		}
+		uint32_t type = p[off / 4], len = p[off / 4 + 1];
+		if (len > bytes - off - 8) {
+			return false;
+		}
+		if (type == 0x2367736d) { /* msg# */
+			if (len != 4) {
+				return false;
+			}
+			id = p[off / 4 + 2];
+		} else if (type == 0x00727265) { /* err */
+			error = true;
+		}
+		off += 8 + ((len + 3) & ~3u);
+		if (off > bytes) {
+			return false;
+		}
+	}
+	if (id == gpu_rpm.msgid) {
+		gpu_rpm.ack = id;
+		gpu_rpm.error = error;
+	}
+	return true;
+}
+
+/* One intentless native GLINK frame. Reject malformed/fragmented replies. */
+static bool
+gpu_rpm_rx(void)
+{
+	uint32_t tail, head;
+	if (!gpu_rpm_indices(gpu_rpm.rx, &tail, &head)) {
+		gpu_rpm.error = true;
+		return false;
+	}
+	uint32_t avail = head >= tail ? head - tail : gpu_rpm.rx.size - tail + head;
+	if (avail < 8) {
+		return false;
+	}
+	uint32_t p[80] = {0};
+	p[0] = smmu_rd(gpu_rpm.ram, gpu_rpm.rx.off + 8 + tail);
+	p[1] = smmu_rd(gpu_rpm.ram, gpu_rpm.rx.off + 8 + (tail + 4) % gpu_rpm.rx.size);
+	uint16_t cmd = (uint16_t)p[0], ch = (uint16_t)(p[0] >> 16);
+	uint32_t bytes = 8;
+	if (cmd == 2) { /* OPEN */
+		if (p[1] == 0 || p[1] > 64) {
+			gpu_rpm.error = true;
+			return false;
+		}
+		bytes = (8 + p[1] + 7) & ~7u;
+	} else if (cmd == 9 || cmd == 12) { /* TX_DATA[_CONT] */
+		if (avail < 16) {
+			return false;
+		}
+		p[2] = smmu_rd(gpu_rpm.ram, gpu_rpm.rx.off + 8 + (tail + 8) % gpu_rpm.rx.size);
+		if (p[2] > 256) {
+			gpu_rpm.error = true;
+			return false;
+		}
+		bytes = (16 + p[2] + 7) & ~7u;
+	}
+	if (bytes > avail) {
+		return false;
+	}
+	for (uint32_t i = 2; i < bytes / 4; i++) {
+		p[i] = smmu_rd(gpu_rpm.ram, gpu_rpm.rx.off + 8 + (tail + i * 4) % gpu_rpm.rx.size);
+	}
+	smmu_wr(gpu_rpm.ram, gpu_rpm.rx.off, (tail + bytes) % gpu_rpm.rx.size);
+	__builtin_arm_dsb(0xf);
+	switch (cmd) {
+	case 0: /* VERSION */
+	case 1: /* VERSION_ACK */
+		if (ch != 1 || p[1] != 0) {
+			gpu_rpm.error = true;
+			break;
+		}
+		gpu_rpm.version = true;
+		if (cmd == 0 && !gpu_rpm_cmd(1, 1, 0)) {
+			gpu_rpm.error = true;
+		}
+		break;
+	case 2:
+		if (p[1] == sizeof("rpm_requests") && memcmp(&p[2], "rpm_requests", sizeof("rpm_requests")) == 0) {
+			gpu_rpm.rcid = ch;
+			gpu_rpm.remote = true;
+		}
+		if (!gpu_rpm_cmd(4, ch, 0)) {
+			gpu_rpm.error = true;
+		}
+		break;
+	case 4:
+		if (ch == 1) {
+			gpu_rpm.open = true;
+		}
+		break;
+	case 9:
+		if (ch != gpu_rpm.rcid || p[3] != 0 || !gpu_rpm_reply(&p[4], p[2])) {
+			gpu_rpm.error = true;
+		}
+		break;
+	case 3: /* CLOSE */
+		(void)gpu_rpm_cmd(11, ch, 0);
+		if (ch == gpu_rpm.rcid) {
+			gpu_rpm.error = true;
+		}
+		break;
+	case 11: /* CLOSE_ACK */
+	case 13: /* READ_NOTIF */
+	case 15: /* SIGNALS */
+		if (cmd == 13) {
+			smmu_wr(gpu_rpm.ipc, 0x0c, 0);
+		}
+		break;
+	default:
+		gpu_rpm.error = true;
+	}
+	return true;
+}
+
+static bool
+gpu_rpm_wait(unsigned state)
+{
+	for (unsigned ms = 0; ms < 1000; ms++) {
+		/* A peer flooding the FIFO must not make this an unbounded wait. */
+		for (unsigned n = 0; n < 32 && !gpu_rpm.error && gpu_rpm_rx(); n++) {}
+		if (gpu_rpm.error) {
+			return false;
+		}
+		if ((state == 0 && gpu_rpm.version) ||
+		    (state == 1 && gpu_rpm.open && gpu_rpm.remote) ||
+		    (state == 2 && gpu_rpm.ack == gpu_rpm.msgid)) {
+			return true;
+		}
+		IOSleep(1);
+	}
+	return false;
+}
+
+static bool
+gpu_rpm_init(void)
+{
+	gpu_rpm_map = gpu_map(0x045f0000, 0x7000);
+	gpu_ipcc_map = gpu_map(0x00208000, 0x1000);
+	if (gpu_rpm_map == NULL || gpu_ipcc_map == NULL) {
+		return false;
+	}
+	gpu_rpm.ram = (uintptr_t)gpu_rpm_map->getVirtualAddress();
+	gpu_rpm.ipc = (uintptr_t)gpu_ipcc_map->getVirtualAddress();
+	const uint32_t toc = 0x7000 - 256;
+	uint32_t count = smmu_rd(gpu_rpm.ram, toc + 4);
+	if (smmu_rd(gpu_rpm.ram, toc) != 0x67727430 || count > 20) {
+		return false;
+	}
+	for (uint32_t i = 0; i < count; i++) {
+		uint32_t id = smmu_rd(gpu_rpm.ram, toc + 8 + i * 12);
+		uint32_t off = smmu_rd(gpu_rpm.ram, toc + 12 + i * 12);
+		uint32_t size = smmu_rd(gpu_rpm.ram, toc + 16 + i * 12);
+		if (id != 0x61703272 && id != 0x72326170) {
+			continue;
+		}
+		if ((off | size) & 7 || size < 512 || off > toc - 8 || size > toc - off - 8) {
+			return false;
+		}
+		struct gpu_rpm_fifo *f = id == 0x61703272 ? &gpu_rpm.tx : &gpu_rpm.rx;
+		if (f->size) {
+			return false;
+		}
+		f->off = off;
+		f->size = size;
+	}
+	if (!gpu_rpm.tx.size || !gpu_rpm.rx.size ||
+	    !(gpu_rpm.tx.off + 8 + gpu_rpm.tx.size <= gpu_rpm.rx.off ||
+	      gpu_rpm.rx.off + 8 + gpu_rpm.rx.size <= gpu_rpm.tx.off)) {
+		return false;
+	}
+	uint32_t tail, head;
+	if (!gpu_rpm_indices(gpu_rpm.tx, &tail, &head) || tail || head ||
+	    !gpu_rpm_indices(gpu_rpm.rx, &tail, &head) || tail || head) {
+		IOLog("SWEET GPU: RPM FIFOs used; refusing a second handshake\n");
+		return false;
+	}
+	if (!gpu_rpm_cmd(0, 1, 0) || !gpu_rpm_wait(0)) {
+		return false;
+	}
+	uint32_t msg[6] = {2 | (1u << 16), sizeof("rpm_requests"), 0, 0, 0, 0};
+	memcpy(&msg[2], "rpm_requests", sizeof("rpm_requests"));
+	return gpu_rpm_send(msg, sizeof(msg)) && gpu_rpm_wait(1);
+}
+
+static bool
+gpu_rpm_vote(uint32_t resource, uint32_t key, uint32_t value)
+{
+	gpu_rpm.msgid++;
+	/* GLINK TX_DATA, req service, active set, resource id 0, one key/value. */
+	uint32_t m[] = {9 | (1u << 16), 0, 40, 0, 0x00716572, 32,
+	               gpu_rpm.msgid, 0, resource, 0, 12, key, 4, value};
+	bool ok = gpu_rpm_send(m, sizeof(m)) && gpu_rpm_wait(2);
+	IOLog("SWEET GPU: RPM resource %x key %x value %x: %s\n", resource, key, value, ok ? "ack" : "failed");
+	return ok;
+}
+
+/* Fixed GPLL0 avoids programming the GPU PLLs. Round voltage UP to the next stock OPP. */
+static bool
+gpu_clock_vote(uint32_t mhz)
+{
+	if (!gpu_rpm_init()) {
+		return false;
+	}
+	const uint32_t resources[] = {0x786d7772, 0x78637772, 0x78677772}; /* rwmx, rwcx, rwgx */
+	for (unsigned i = 0; i < 3; i++) {
+		uint32_t level = i == 2 && mhz == 400 ? 0xc0 : 0x100;
+		if (!gpu_rpm_vote(resources[i], 0x6c766c76, level) || /* vlvl */
+		    !gpu_rpm_vote(resources[i], 0x6e657773, 1)) { /* swen */
+			return false;
+		}
+	}
+	IODelay(100);
+	return true;
+}
+
+static bool
+gpu_clock_set(uint32_t mhz)
+{
+	uintptr_t cc = (uintptr_t)gpu_cc_map->getVirtualAddress();
+	uint32_t cfg = smmu_rd(cc, 0x1020);
+	uint32_t hid = mhz == 600 ? 1 : mhz == 400 ? 2 : 3;
+	cfg = (cfg & ~0x71fu) | (5u << 8) | hid;
+	smmu_wr(cc, 0x1020, cfg);
+	smmu_wr(cc, 0x101c, smmu_rd(cc, 0x101c) | 1);
+	for (unsigned i = 0; i < 1000; i++) {
+		if ((smmu_rd(cc, 0x101c) & 1) == 0) {
+			return (smmu_rd(cc, 0x1020) & 0x71f) == (cfg & 0x71f);
+		}
+		IODelay(1);
+	}
+	return false;
+}
+
+/* Exercise the 2D engine and cache flush, not just a clock register readback. */
+static bool
+gpu_clock_selftest(void)
+{
+	uintptr_t low = (uintptr_t)gpu_low_map->getVirtualAddress();
+	volatile uint32_t *src = (volatile uint32_t *)(low + 0x21000);
+	volatile uint32_t *dst = (volatile uint32_t *)(low + 0x22000);
+	for (unsigned i = 0; i < 64; i++) {
+		src[i] = 0xff000000u | (i * 0x010203u);
+		dst[i] = 0;
+	}
+	__builtin_arm_dsb(0xf);
+	event(CACHE_INVALIDATE, false);
+	emit(pkt7(CP_WAIT_FOR_IDLE, 0));
+	blit(GPU_LOW_PHYS + 0x21000, 64, 16, 4, 0, 0,
+	    GPU_LOW_PHYS + 0x22000, 64, 0, 0, 16, 4);
+	event(PC_CCU_FLUSH_COLOR_TS, true);
+	emit(pkt7(CP_WAIT_FOR_IDLE, 0));
+	event(CACHE_FLUSH_TS, true);
+	kick();
+	if (!ring_idle(100)) {
+		return false;
+	}
+	for (unsigned i = 0; i < 64; i++) {
+		if (src[i] != dst[i]) {
+			return false;
+		}
+	}
+	return true;
+}
+
+static bool
+gpu_clock_init(void)
+{
+	uint32_t mhz = 300;
+	PE_parse_boot_argn("sweetgpu_mhz", &mhz, sizeof(mhz));
+	if (mhz == 300) {
+		return true;
+	}
+	if (mhz != 400 && mhz != 600) {
+		IOLog("SWEET GPU: sweetgpu_mhz supports 300, 400, 600; kept shim clock\n");
+		return true;
+	}
+	gpu_cc_map = gpu_map(0x05990000, 0x9000);
+	if (gpu_cc_map == NULL || !gpu_clock_vote(mhz)) {
+		IOLog("SWEET GPU: clock vote failed, kept shim clock\n");
+		return true;
+	}
+	if (gpu_clock_set(mhz) && gpu_clock_selftest()) {
+		gpu_core_mhz = mhz;
+		IOLog("SWEET GPU: core %u MHz, RPM acked, 2D selftest passed\n", mhz);
+		return true;
+	}
+	IOLog("SWEET GPU: %u MHz failed; restoring 300 MHz\n", mhz);
+	if (!gpu_clock_set(300)) {
+		gpu_state = -1; /* clock may be unresponsive: avoid more GPU MMIO */
+		IOLog("SWEET GPU: clock rollback failed; CPU copies\n");
+		return false;
+	}
+	gpu_core_mhz = 300;
+	if (!gpu_recover("clock selftest", NULL) || !gpu_clock_selftest()) {
+		(void)gpu_halt();
+		gpu_assert_reset();
+		gpu_off("clock fallback selftest failed");
+		return false;
+	}
+	return true;
+}
