+/* Poll bounded waits while holding the ring lock. */
+static bool
+gpu_poll(uint32_t reg, uint32_t mask, uint32_t value)
+{
+	for (unsigned i = 0; i < 1000; i++) {
+		if ((gpu_regs[reg] & mask) == value) {
+			return true;
+		}
+		IODelay(10);
+	}
+	return false;
+}
+
+/* a619_holi: SQE halt, GPR0 GBIF drain, then client/AXI halt (Linux a6xx). */
+static bool
+gpu_halt(void)
+{
+	gpu_regs[REG_CP_SQE_CNTL] = 3;
+	__builtin_arm_dsb(0xf);
+	gpu_regs[REG_RBBM_GPR0_CNTL] = 0x1e0;
+	if (!gpu_poll(REG_VBIF_RESET_STATUS, 0xf0, 0xf0)) {
+		return false;
+	}
+	gpu_regs[REG_GBIF_HALT] = 1;
+	if (!gpu_poll(REG_GBIF_HALT_ACK, 1, 1)) {
+		return false;
+	}
+	gpu_regs[REG_GBIF_HALT] = 3;
+	return gpu_poll(REG_GBIF_HALT_ACK, 3, 3);
+}
+
+static void
+gpu_assert_reset(void)
+{
+	gpu_regs[REG_RBBM_SW_RESET_CMD] = 1;
+	(void)gpu_regs[REG_RBBM_SW_RESET_CMD];
+	__builtin_arm_dsb(0xf);
+	IODelay(100); /* Linux: reset must be asserted for at least 100 us. */
+}
+
+/* Reset only with the ring lock held; keep the client attached until DMA drains. */
+static bool
+gpu_recover(const char *why, struct sweet_gpu_vm *vm)
+{
+	IOLog("SWEET GPU: reset: %s (rptr %x wptr %x rbbm %x hwf %x prot %x)\n",
+	    why, gpu_regs[REG_CP_RB_RPTR], gpu_wptr, gpu_regs[REG_RBBM_STATUS],
+	    gpu_regs[REG_CP_HW_FAULT], gpu_regs[REG_CP_PROTECT_STATUS]);
+	bool drained = gpu_halt();
+	gpu_assert_reset();
+	gpu_queued = 0;
+	if (!drained) {
+		if (vm != NULL) {
+			vm->quarantined = true;
+		}
+		/* Leave reset asserted and the original SMMU mapping in place. */
+		gpu_off("bus drain failed; reset held, VM pinned");
+		return false;
+	}
+	smmu_detach(NULL, NULL, NULL);
+	gpu_regs[REG_RBBM_SW_RESET_CMD] = 0;
+	(void)gpu_regs[REG_RBBM_SW_RESET_CMD];
+	IODelay(1);
+	gpu_regs[REG_GBIF_HALT] = 0;
+	gpu_regs[REG_RBBM_GPR0_CNTL] = 0;
+	/* SPTPRAC is inside the wrapper, outside the GX reset. */
+	gpu_regs[0x1a881] = 0x778000;
+	if (!gpu_poll(0x1f8d0, 0x38, 0x28)) {
+		gpu_assert_reset();
+		gpu_off("SPTPRAC restart failed");
+		return false;
+	}
+	for (unsigned i = 0; i < sizeof(gpu_restore_regs) / sizeof(gpu_restore_regs[0]); i++) {
+		gpu_regs[gpu_restore_regs[i]] = gpu_restore_values[i];
+	}
+	gpu_init_cp_protect();
+	/* Never copy the old RPTR into WPTR: discard the entire abandoned stream. */
+	for (uint32_t i = 0; i < gpu_ring_dwords; i++) {
+		gpu_ring[i] = 0;
+	}
+	gpu_wptr = 0;
+	gpu_regs[0x830] = (uint32_t)GPU_SQE_PHYS;
+	gpu_regs[0x831] = 0;
+	gpu_regs[0x800] = (uint32_t)GPU_RING_PHYS;
+	gpu_regs[0x801] = 0;
+	gpu_regs[0x802] = 12 | (2 << 8) | (1u << 27);
+	gpu_regs[REG_CP_RB_WPTR] = 0;
+	__builtin_arm_dsb(0xf);
+	gpu_regs[REG_CP_SQE_CNTL] = 1;
+	IODelay(1000);
+	emit(pkt7(CP_ME_INIT, 8));
+	emit(0x2f);
+	emit(3);
+	emit(0x20000000);
+	for (unsigned i = 0; i < 5; i++) {
+		emit(0);
+	}
+	emit(pkt7(CP_SET_SECURE_MODE, 1));
+	emit(0);
+	/* The shim's a619 2D baseline, including sysmem CCU and the render mode. */
+	static const uint32_t magic[][2] = {
+		{0x9804, 0x1f}, {0x9805, 0}, {0xa0f8, 0}, {0xb600, 0x00108000},
+		{0x8600, 0x880}, {0xae03, 0x430}, {0xae00, 0}, {0xbe04, 0x00080000},
+		{0x9600, 0}, {0x0e12, 1}, {0x8e01, 1}, {0x8e04, 0x04100000},
+	};
+	for (unsigned i = 0; i < sizeof(magic) / sizeof(magic[0]); i++) {
+		reg1(magic[i][0], magic[i][1]);
+	}
+	event(0x19, false); /* PC_CCU_INVALIDATE_COLOR */
+	event(0x18, false); /* PC_CCU_INVALIDATE_DEPTH */
+	emit(pkt7(CP_WAIT_FOR_IDLE, 0));
+	reg1(0x8e07, (0x10000u >> 12) << 23);
+	emit(pkt7(CP_SET_MARKER, 1));
+	emit(12); /* RM6_BLIT2DSCALE */
+	event(CACHE_FLUSH_TS, true);
+	kick();
+	if (!ring_idle(100)) {
+		(void)gpu_halt();
+		gpu_assert_reset();
+		gpu_off("CP restart fence failed");
+		return false;
+	}
+	gpu_resets++;
+	IOLog("SWEET GPU: CP recovered (%llu resets), fence %u\n", gpu_resets, gpu_seqno);
+	return true;
+}
+
+/* A stale kernel fence is also a wedge, even when RPTR has reached WPTR. */
+static bool
+gpu_prepare(void)
+{
+	return gpu_state > 0 && (ring_idle(100) || gpu_recover("before submit", NULL));
+}
+
+/* Capture the fault BEFORE reset clears it; bypass is allowed only after quiescence. */
+static bool
+gpu_finish_vm(struct sweet_gpu_vm *vm, bool done,
+    uint32_t *fsr, uint64_t *far, uint32_t *syn)
+{
+	*fsr = smmu_rd(gpu_cb0, SMMU_CB0_FSR);
+	*far = ((uint64_t)smmu_rd(gpu_cb0, 0x64) << 32) | smmu_rd(gpu_cb0, 0x60);
+	*syn = smmu_rd(gpu_cb0, 0x68);
+	if (!done || (*fsr & 0x3feu) != 0) {
+		(void)gpu_recover("client submission failed", vm);
+		return false;
+	}
+	smmu_detach(NULL, NULL, NULL);
+	return true;
+}
