+}
+
+/* a SWEET_DROP_MEM entry by its full path; the data stays valid for the whole boot */
+bool
+sweet_drop_find(const char *path, const void **data, uint32_t *size)
+{
+	uint64_t total = 0;
+	uint32_t count = 0;
+	const uint8_t *a = sweet_drop_archive(&total, &count);
+
+	if (a == NULL) {
+		return false;
+	}
+	const struct sweet_drop_ent *e = (const struct sweet_drop_ent *)(a + 16);
+	for (uint32_t i = 0; i < count; i++) {
+		if ((e[i].mode & SWEET_DROP_MEM) != 0 && (uint64_t)e[i].offset + e[i].size <= total &&
+		    strncmp(e[i].path, path, sizeof(e[i].path)) == 0) {
+			*data = a + e[i].offset;
+			*size = e[i].size;
+			return true;
+		}
+	}
+	return false;
 }
