  *   count x { char path[128]; u32 mode; u32 size; u32 offset; u32 pad }
  * offsets from the archive start. Existing files are replaced; the parent
  * directories must exist. Each file is logged ("SWEET DROP: ...").
+ *
+ * An entry whose mode has SWEET_DROP_MEM set is not written anywhere: it stays in
+ * the archive for the kernel to read with sweet_drop_find() (the RAMDisk range is
+ * registered as /dev/md0 and never freed). First user: the vendor sensor configs
+ * the ADSP reads through FastRPC (iokit/Kernel/arm/SweetAppsStd.cpp), which live
+ * on the EROFS vendor partition the kernel cannot read.
  */
 #if defined(ARM64_BOARD_CONFIG_SWEET)
 #include <sys/param.h>
@@ -24,8 +30,13 @@
 #include <sys/kauth.h>
 #include <pexpert/device_tree.h>
 #include <machine/machine_routines.h>
+#include <stdbool.h>
 
 void sweet_drop_files(void);
+bool sweet_drop_find(const char *path, const void **data, uint32_t *size);
+
+#define SWEET_DROP_MEM          0x80000000u     /* kept in memory, not installed */
+#define SWEET_DROP_MAX          256u
 
 struct sweet_drop_ent {
 	char     path[128];
@@ -68,28 +79,42 @@ sweet_drop_one(const char *path, uint32_t mode, const void *data, uint32_t size)
 	return err;
 }
 
-void
-sweet_drop_files(void)
