+}
+
+void
+sweet_drop_files(void)
+{
+	uint64_t total = 0;
+	uint32_t count = 0, kept = 0;
+	const uint8_t *a = sweet_drop_archive(&total, &count);
+
+	if (a == NULL) {
 		return;
 	}
 	const struct sweet_drop_ent *e = (const struct sweet_drop_ent *)(a + 16);
@@ -101,8 +126,38 @@ sweet_drop_files(void)
 			printf("SWEET DROP: %s: outside the archive\n", path);
 			continue;
 		}
+		if (e[i].mode & SWEET_DROP_MEM) {
+			kept++;
+			continue;
+		}
 		int err = sweet_drop_one(path, e[i].mode, a + e[i].offset, e[i].size);
 		printf("SWEET DROP: %s (%u bytes, mode %o) -> %d\n", path, e[i].size, e[i].mode, err);
 	}
+	if (kept != 0) {
