+	memcpy(count, a + 12, 4);
+	*total = rd[1];
+	if (version != 1 || *count > SWEET_DROP_MAX || 16 + (uint64_t)*count * sizeof(struct sweet_drop_ent) > *total) {
+		printf("SWEET DROP: bad archive (version %u, %u files)\n", version, *count);
