+sweet_drop_archive(uint64_t *total, uint32_t *count)
 {
 	DTEntry map = NULL;
 	uintptr_t const *rd = NULL;
 	unsigned int len = 0;
+	uint32_t version;
 
 	if (SecureDTLookupEntry(NULL, "/chosen/memory-map", &map) != kSuccess ||
 	    SecureDTGetProperty(map, "RAMDisk", (void const **)&rd, &len) != kSuccess ||
-	    len < 2 * sizeof(uintptr_t) || rd[1] < 12) {
