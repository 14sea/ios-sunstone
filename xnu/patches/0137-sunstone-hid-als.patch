+/*
+ * Ambient light sensor: AppleVendor page 0xff00, usage 4, the pair Apple's ALS services
+ * publish. CoreBrightness (CBALSService, CBALSNodeiOS in backboardd) opens it, takes the
+ * kIOHIDEventTypeAmbientLightSensor events and also polls with IOHIDServiceClientCopyEvent
+ * (copyALSEvent, "Failed to copy kIOHIDEventTypeAmbientLightSensor event"): copyEvent()
+ * answers with the last report. Fed from the ADSP's SEE ambient_light stream (TopazModem).
+ */
+#define kHIDPage_AppleVendorSweet               0xff00
+#define kHIDUsage_AppleVendor_AmbientLightSweet 0x0004
+class SweetHIDALS : public IOHIDEventService {
+	OSDeclareDefaultStructors(SweetHIDALS);
+public:
+	virtual bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	virtual IOHIDEvent *copyEvent(IOHIDEventType type, IOHIDEvent *matching, IOOptionBits options) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn setProperties(OSObject *properties) APPLE_KEXT_OVERRIDE;
+	void report(uint32_t lux_milli, uint32_t raw);
+protected:
+	virtual UInt32 getPrimaryUsagePage() APPLE_KEXT_OVERRIDE { return kHIDPage_AppleVendorSweet; }
+	virtual UInt32 getPrimaryUsage() APPLE_KEXT_OVERRIDE { return kHIDUsage_AppleVendor_AmbientLightSweet; }
+	virtual UInt32 getProductID() APPLE_KEXT_OVERRIDE { return 3; }
+	virtual UInt32 getReportInterval() APPLE_KEXT_OVERRIDE { return 100000; }	/* us: SEE reports ~10 Hz */
+private:
+	IOLock *fLock;
+	IOHIDEvent *fLast;
+	uint32_t fReports, fCopies, fPropsLogged;
+};
+OSDefineMetaClassAndStructors(SweetHIDALS, IOHIDEventService);
+
 static SweetHIDButtons *gSweetButtons;
 static SweetHIDTouch *gSweetTouch;
+static SweetHIDALS *gSweetALS;
 
