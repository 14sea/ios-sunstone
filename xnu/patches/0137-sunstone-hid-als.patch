@@ -538,6 +573,99 @@ SweetHIDTouch::touch(int finger, bool down, int x, int y)
 	collection->release();
 }
 
+bool
+SweetHIDALS::start(IOService *provider)
+{
+	fLock = IOLockAlloc();
+	if (!fLock || !IOHIDEventService::start(provider)) {
+		return false;
+	}
+	gSweetALS = this;
+	registerService();
+	IOLog("SWEET HID: ambient light sensor registered (page 0x%x usage 0x%x)\n",
+	    kHIDPage_AppleVendorSweet, kHIDUsage_AppleVendor_AmbientLightSweet);
+	return true;
+}
+
+void
+SweetHIDALS::report(uint32_t lux_milli, uint32_t raw)
+{
+	uint32_t lux = (lux_milli + 500) / 1000;
+	IOHIDEvent *event = IOHIDEvent::ambientLightSensorEvent(mach_absolute_time(), lux, raw, 0, 0, 0);
+
+	if (!event) {
+		return;
+	}
+	event->setDoubleValue(kIOHIDEventFieldAmbientLightSensorIlluminance, (IOHIDDouble)lux_milli / 1000.0, 0);
+	IOLockLock(fLock);
+	IOHIDEvent *old = fLast;
+	fLast = event;
+	event->retain();
+	uint32_t n = ++fReports;
+	IOLockUnlock(fLock);
+	OSSafeReleaseNULL(old);
+	if (n <= 3 || n % 100 == 0) {
+		IOLog("SWEET HID: als report %u: %u lux (raw %u, %u clients, %u copies)\n", n, lux, raw,
+		    _clients ? _clients->getCount() : 0, fCopies);
+	}
+	dispatchEvent(event);
+	event->release();
+}
+
+IOHIDEvent *
+SweetHIDALS::copyEvent(IOHIDEventType type, IOHIDEvent *matching __unused, IOOptionBits options __unused)
+{
+	IOHIDEvent *event = NULL;
+
+	if (type != kIOHIDEventTypeAmbientLightSensor && type != kIOHIDEventTypeNULL) {
+		return NULL;
+	}
+	IOLockLock(fLock);
+	if (fLast) {
+		event = fLast;
+		event->retain();
+	}
+	uint32_t n = ++fCopies;
+	IOLockUnlock(fLock);
+	if (n <= 3 || n % 100 == 0) {
+		IOLog("SWEET HID: als copyEvent %u (type %u) -> %s\n", n, (unsigned)type, event ? "last report" : "none yet");
+	}
+	return event;
+}
+
+/* CoreBrightness configures the service (setALSServiceProperty:forKey:): log what it sends */
+IOReturn
+SweetHIDALS::setProperties(OSObject *properties)
+{
+	OSDictionary *dict = OSDynamicCast(OSDictionary, properties);
+
+	if (!dict) {
+		return kIOReturnBadArgument;
+	}
+	OSCollectionIterator *it = OSCollectionIterator::withCollection(dict);
+	for (OSSymbol *key; it && (key = OSDynamicCast(OSSymbol, it->getNextObject())) != NULL;) {
+		if (fPropsLogged >= 40) {
+			break;
+		}
+		fPropsLogged++;
+		OSNumber *num = OSDynamicCast(OSNumber, dict->getObject(key));
+		OSBoolean *b = OSDynamicCast(OSBoolean, dict->getObject(key));
+		IOLog("SWEET HID: als property %s = %s%llu\n", key->getCStringNoCopy(),
+		    b ? (b->getValue() ? "true " : "false ") : "", num ? num->unsigned64BitValue() : 0);
+	}
+	OSSafeReleaseNULL(it);
+	return kIOReturnSuccess;
+}
+
+/* the ambient light from the ADSP's SEE stream: lux in thousandths, the sensor's raw count */
+extern "C" void
+sweet_hid_als(uint32_t lux_milli, uint32_t raw)
+{
+	if (gSweetALS) {
+		gSweetALS->report(lux_milli, raw);
+	}
+}
+
