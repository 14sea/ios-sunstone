+/*
+ * Plain 32-bit LDR/STR with a register address: the hypervisor (Gunyah) traps and emulates SMMU
+ * accesses on sunstone and a writeback/pair access has no valid syndrome (ISV=0): it would hang
+ * (found on the GPU SMMU, SweetGPU.cpp). The copy engines get the same, harmlessly.
+ */
+static inline uint32_t
+r32(volatile uint8_t *b, uint32_t o)
+{
+	uint32_t v;
+	__asm__ volatile ("ldr %w0, [%1]" : "=r"(v) : "r"(b + o) : "memory");
+	return v;
+}
+static inline void
+w32(volatile uint8_t *b, uint32_t o, uint32_t v)
+{
+	mb();
+	__asm__ volatile ("str %w0, [%1]" : : "rZ"(v), "r"(b + o) : "memory");
+}
 
