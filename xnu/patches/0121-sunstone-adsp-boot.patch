+/*
+ * One TrustZone PAS image from modem_a (Linux qcom_mdt_load + qcom_q6v5_pas): metadata -> init_image ->
+ * mem_setup -> segments into the carveout -> auth_and_reset. Relocatable images (MDT_RELOCATABLE) go
+ * to carve + (p_paddr - lowest p_paddr), as qcom_mdt_load's mem_reloc does: the modem's own addresses
+ * already are its carveout, the ADSP's (0x53400000) are not.
+ */
+struct pas_image {
+	const char *name;                   /* "modem": fw_files table with CRCs; else image/<name>.* via fw_all */
+	uint32_t    pas_id;
+	uint64_t    carve, carve_size;
+};
+
+static int64_t
+pas_fw_size(const struct pas_image *im, const char *file)
+{
+	if (strcmp(im->name, "modem") == 0) {
+		return fw_size(file);
+	}
+	char path[48];
+	snprintf(path, sizeof(path), "image/%s", file);
+	int i = fw_all_find(path);
+	return i < 0 ? -1 : (int64_t)fw_all[i].size;
+}
+
+static int64_t
+pas_fw_read(const struct pas_image *im, const char *file, void *dst, uint64_t max)
+{
+	if (strcmp(im->name, "modem") == 0) {
+		return fw_read(file, dst, max);
+	}
+	char path[48];
+	snprintf(path, sizeof(path), "image/%s", file);
+	int i = fw_all_find(path);
+	if (i < 0 || fw_all[i].size > max || !fw_all_read(i, 0, dst, fw_all[i].size)) {
+		LOG("%s: missing or unreadable", path);
+		return -1;
+	}
+	return fw_all[i].size;
+}
