+static bool
+modem_boot(void)
+{
+	static const struct pas_image modem = { "modem", PAS_ID_MODEM, MODEM_CARVEOUT, MODEM_CARVEOUT_SIZE };
+	struct smem_part_hdr *part = smem_partition(0, 1);
+	LOG("SMEM apps<->modem partition %p", part);
+	if (part == NULL) {
+		return false;
+	}
+	if (smem_get(part, ITEM_SMP2P_IN, NULL) != NULL) {
+		LOG("modem SMP2P item %u already exists: modem is not cold, not touching it", ITEM_SMP2P_IN);
+		return false;
+	}
+	return pas_boot(&modem);
+}
+
+/*
+ * ADSP (LPASS, sunstone qcom,lpass@a400000): PAS id 1, adsp.mdt relocatable into adsp@86700000
+ * (0x2800000), SMEM host 2: SMP2P in 443 / out 429, crash reason 423, doorbells IPCC client 3
+ * (LPASS). Step 1 (boot-arg adsp=1): boot it and watch its SMP2P "slave-kernel" READY bit; its GLINK
+ * edge (SMEM 478-480 in the apps<->adsp partition) is only logged. The proxy rails (lpi cx/mx) are
+ * not voted: what the bootloader left on has to do.
+ */
+#define ADSP_CARVEOUT           0x86700000ull
+#define ADSP_CARVEOUT_SIZE      0x02800000ull
+#define PAS_ID_ADSP             1
+#define ADSP_HOST               2
+#define ADSP_ITEM_SMP2P_IN      443
+#define ADSP_ITEM_CRASH         423
+
+static void
+adsp_boot(void)
+{
+	static const struct pas_image adsp = { "adsp", PAS_ID_ADSP, ADSP_CARVEOUT, ADSP_CARVEOUT_SIZE };
+	struct smem_part_hdr *part = smem_partition(0, ADSP_HOST);
+	uint32_t sz = 0, sk_last = ~0u;
+	LOG("adsp: SMEM apps<->adsp partition %p", part);
+	if (part == NULL) {
+		return;
+	}
+	if (smem_get(part, ADSP_ITEM_SMP2P_IN, NULL) != NULL) {
+		LOG("adsp: SMP2P item %u already exists: ADSP is not cold, not touching it", ADSP_ITEM_SMP2P_IN);
+		return;
+	}
+	if (!pas_boot(&adsp)) {
+		return;
+	}
+	for (unsigned ms = 0; ms < 15000; ms += 10) {
+		struct smp2p_hdr *in = (struct smp2p_hdr *)smem_get(part, ADSP_ITEM_SMP2P_IN, &sz);
+		volatile uint32_t *sk = (in != NULL && in->magic == SMP2P_MAGIC) ? smp2p_find(in, "slave-kernel") : NULL;
+		uint32_t v = sk != NULL ? *sk : 0;
+		if (sk != NULL && v != sk_last) {
+			LOG("adsp: t=%u ms: slave-kernel %08x%s%s", ms, v, (v & 1) ? " FATAL" : "", (v & 2) ? " READY" : "");
+			sk_last = v;
+		}
+		if (v & 1) {
+			const char *why = (const char *)smem_get(smem_partition(SMEM_GLOBAL_HOST, SMEM_GLOBAL_HOST), ADSP_ITEM_CRASH, &sz);
+			LOG("adsp: crash reason: %.*s", why != NULL ? (int)MIN(sz, 200u) : 4, why != NULL ? why : "none");
+			return;
+		}
+		if (v & 2) {
+			break;
+		}
+		IOSleep(10);
+	}
+	bool glink = smem_get(part, SMEM_GLINK_DESC, NULL) != NULL;
+	LOG("adsp: %s; GLINK descriptor in the apps<->adsp partition: %s", (sk_last != ~0u && (sk_last & 2)) ? "*** ADSP UP ***" : "no READY within 15 s",
+	    glink ? "yes (made by the ADSP)" : "no");
+}
