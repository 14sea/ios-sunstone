diff --git a/osfmk/arm64/sleh.c b/osfmk/arm64/sleh.c
index a2a8c1b..1abad31 100644
--- a/osfmk/arm64/sleh.c
+++ b/osfmk/arm64/sleh.c
@@ -1925,6 +1925,61 @@ handle_simd_trap(arm_saved_state_t *state, uint32_t esr)
 	__builtin_unreachable();
 }
 
+void
+sleh_irq(arm_saved_state_t *state);
+
+#if defined(SWEET)
+/*
+ * sunstone: where does a CPU spin? Every virtual-timer IRQ that interrupts
+ * kernel code records, per CPU, the interrupted pc/lr, the current thread's
+ * id and up to 8 kernel frames (bounded by that thread's kernel stack).
+ * bsd/dev/sweet_sample.c prints them. A CPU whose irq count stops moving
+ * has interrupts masked.
+ */
+#define SWEET_IRQS_CPUS 8
+#define SWEET_IRQS_FRAMES 8
+struct sweet_irq_rec {
+	uint64_t kernel_irqs, user_irqs, last_time, thread_id, pc, lr;
+	uint64_t frames[SWEET_IRQS_FRAMES];
+};
+struct sweet_irq_rec sweet_irq_recs[SWEET_IRQS_CPUS];
+
+static void
+sweet_irq_record(arm_saved_state_t *state, unsigned int cpu)
+{
+	if (cpu >= SWEET_IRQS_CPUS) {
+		return;
+	}
+	struct sweet_irq_rec *r = &sweet_irq_recs[cpu];
+	if (PSR64_IS_USER(get_saved_state_cpsr(state))) {
+		r->user_irqs++;
+		return;
+	}
+	thread_t th = current_thread();
+	uint64_t lo = th->kernel_stack, hi = lo + kernel_stack_size;
+	uint64_t fp = get_saved_state_fp(state);
+	int i = 0;
+
+	r->kernel_irqs++;
+	r->last_time = mach_absolute_time();
+	r->thread_id = th->thread_id;
+	r->pc = VM_KERNEL_UNSLIDE(get_saved_state_pc(state));
+	r->lr = VM_KERNEL_UNSLIDE(get_saved_state_lr(state));
+	for (; i < SWEET_IRQS_FRAMES && lo != 0 && fp >= lo && fp + 16 <= hi && (fp & 7) == 0; i++) {
+		uint64_t *frame = (uint64_t *)fp;
+		r->frames[i] = VM_KERNEL_UNSLIDE(frame[1]);
+		if (frame[0] <= fp) {
+			i++;
+			break;
+		}
+		fp = frame[0];
+	}
+	for (; i < SWEET_IRQS_FRAMES; i++) {
+		r->frames[i] = 0;
+	}
+}
+#endif
+
 void
 sleh_irq(arm_saved_state_t *state)
 {
@@ -1946,6 +2001,7 @@ sleh_irq(arm_saved_state_t *state)
 		return; /* spurious */
 	}
 	if (intid == sweet_vtimer_intid) {
+		sweet_irq_record(state, cdp->cpu_number);
 		sleh_interrupt_handler_prologue(state, DBG_INTR_TYPE_TIMER);
 		cdp->cpu_decrementer = -1; /* Large */
 		INTERRUPT_MASKED_DEBUG_START(rtclock_intr, DBG_INTR_TYPE_TIMER);
