+		}
+		uint64_t age_ms = 0;
+		absolutetime_to_nanoseconds(now - r.last_time, &age_ms);
+		printf("SMP cpu%d irq k%llu u%llu age %llums tid %llu pc 0x%llx lr 0x%llx bt"
+		    " 0x%llx 0x%llx 0x%llx 0x%llx 0x%llx 0x%llx 0x%llx 0x%llx\n",
+		    c, r.kernel_irqs, r.user_irqs, age_ms / 1000000, r.thread_id, r.pc, r.lr,
+		    r.frames[0], r.frames[1], r.frames[2], r.frames[3],
+		    r.frames[4], r.frames[5], r.frames[6], r.frames[7]);
+	}
+}
