+static void
+sweet_sample_irqs(void)
+{
+	uint64_t now = mach_absolute_time();
+	for (int c = 0; c < 8; c++) {
+		struct sweet_irq_rec r = sweet_irq_recs[c];   /* racy copy, diagnostic */
+		if (r.kernel_irqs == 0 && r.user_irqs == 0) {
