 	SWEET_GPU_PARAM_CORE_MHZ    = 6,        /* selected clock (RCG readback + 2D selftest) */
 	SWEET_GPU_PARAM_RESETS      = 7,        /* successful CP recoveries */
+	/* Last completed sweetgpu report; readable even after GPU fallback. */
+	SWEET_GPU_PARAM_TEST_RESULT = 8,        /* 0 absent, 1 PASS, 2 FAIL */
+	SWEET_GPU_PARAM_TEST_FAILURES = 9,      /* user test's failure count */
+	SWEET_GPU_PARAM_TEST_OBSERVED = 10,     /* kernel-read BO canary */
+	SWEET_GPU_PARAM_TEST_EXPECTED = 11,
+	SWEET_GPU_PARAM_TEST_FLAGS = 12,        /* bit 0 wedge, bit 1 CP_PROTECT */
