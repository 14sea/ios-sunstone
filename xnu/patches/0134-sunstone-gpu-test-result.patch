diff --git a/iokit/Kernel/arm/SweetGPU.cpp b/iokit/Kernel/arm/SweetGPU.cpp
--- a/iokit/Kernel/arm/SweetGPU.cpp
+++ b/iokit/Kernel/arm/SweetGPU.cpp
@@ -175,6 +175,7 @@
 static IOLock             *gpu_init_lock; /* serializes the entire one-time handoff/clock init */
 static uint64_t            gpu_resets;
 static uint32_t            gpu_core_mhz;
+static uint64_t            gpu_test_report[6]; /* params TEST_RESULT..TEST_REPORTS */
 /* Restart probe fences do not prove a workload can run. Stop after three failures. */
 #define GPU_MAX_RECOVERY_STREAK 3u
 static uint32_t            gpu_recovery_streak;
@@ -1478,6 +1479,15 @@
 uint64_t
 sweet_gpu_param(uint32_t which)
 {
+	if (which >= SWEET_GPU_PARAM_TEST_RESULT && which <= SWEET_GPU_PARAM_TEST_REPORTS) {
+		if (!gpu_lock_get()) {
+			return 0;
+		}
+		IOLockLock(gpu_lock);
+		uint64_t value = gpu_test_report[which - SWEET_GPU_PARAM_TEST_RESULT];
+		IOLockUnlock(gpu_lock);
+		return value;
+	}
 	if (!gpu_init()) {
 		return 0;
 	}
@@ -1503,6 +1513,29 @@
 	}
 }
 
+bool
+sweet_gpu_report_test(uint32_t failures, uint32_t flags, uint32_t observed)
+{
+	if (flags > 3 || !gpu_lock_get()) {
+		return false;
+	}
+	uint32_t expected = (flags & 2) ? 0xc0ffee45u :
+	    (flags & 1) ? 0xc0ffee44u : 0xc0ffee43u;
+	IOLockLock(gpu_lock);
+	bool pass = failures == 0 && observed == expected;
+	gpu_test_report[0] = pass ? 1 : 2;
+	gpu_test_report[1] = failures;
+	gpu_test_report[2] = observed;
+	gpu_test_report[3] = expected;
+	gpu_test_report[4] = flags;
+	gpu_test_report[5]++;
+	IOLog("SWEET GPU: sweetgpu result %s (failures %u, flags 0x%x, canary 0x%08x expected 0x%08x, core %u MHz, resets %llu, reports %llu)\n",
+	    pass ? "PASS" : "FAIL", failures, flags, observed, expected,
+	    gpu_core_mhz, gpu_resets, gpu_test_report[5]);
+	IOLockUnlock(gpu_lock);
+	return true;
+}
+
 #else /* !SWEET */
 
 struct sweet_gpu_vm *
@@ -1570,6 +1603,12 @@
 }
 
 bool
+sweet_gpu_report_test(uint32_t, uint32_t, uint32_t)
+{
+	return false;
+}
