diff --git a/makedefs/MakeInc.def b/makedefs/MakeInc.def
index 7a7cf4d..27e8c8a 100644
--- a/makedefs/MakeInc.def
+++ b/makedefs/MakeInc.def
@@ -61,9 +61,9 @@ MACHINE_FLAGS_ARM64_T8103 = -DARM64_BOARD_CONFIG_T8103                  -mcpu=ap
 MACHINE_FLAGS_ARM64_T6000 = -DARM64_BOARD_CONFIG_T6000 		-mcpu=apple-a14
 MACHINE_FLAGS_ARM64_VMAPPLE = -DARM64_BOARD_CONFIG_VMAPPLE              -march=armv8.5a
 MACHINE_FLAGS_ARM64_BCM2837 = -DARM64_BOARD_CONFIG_BCM2837
-# topaz: Cortex-A53/A73 are ARMv8.0 (no LSE atomics, RCpc, PAN or FP16). An explicit
-# -mcpu: -arch arm64 otherwise keeps clang's apple-m1 default and its LSE/RCpc features
-MACHINE_FLAGS_ARM64_SWEET = -DARM64_BOARD_CONFIG_SWEET                -mcpu=cortex-a53
+# sunstone: Cortex-A55 (and A78) are ARMv8.2 with LSE, RCpc, PAN and crypto. An explicit
+# -mcpu: -arch arm64 otherwise keeps clang's apple-m1 default (topaz used cortex-a53)
+MACHINE_FLAGS_ARM64_SWEET = -DARM64_BOARD_CONFIG_SWEET                -mcpu=cortex-a55+crypto
 
 
 #
diff --git a/pexpert/pexpert/arm64/SWEET.h b/pexpert/pexpert/arm64/SWEET.h
index 424e1c0..db08a28 100644
--- a/pexpert/pexpert/arm64/SWEET.h
+++ b/pexpert/pexpert/arm64/SWEET.h
@@ -34,7 +34,14 @@
 #define __ARM_DEBUG__             7
 #define __ARM_ENABLE_SWAP__       1
 #define __ARM_V8_CRYPTO_EXTENSIONS__ 1
-/* topaz: Cortex-A53/A73 have no PAN (ARMv8.1); MSR PAN is undefined there */
+/*
+ * sunstone: Cortex-A55/A78 implement PAN, and SCTLR_EL1.SPAN = 0 makes every
+ * exception to EL1 set PSTATE.PAN. Without __ARM_PAN_AVAILABLE__ copyio never
+ * clears it, so each copyin/copyout permission-faults, vm_fault finds the page
+ * present and returns, and the access retries forever (launchd stuck in
+ * mach_vm_allocate / exec_save_path copyinstr). topaz (A53) has no PAN.
+ */
+#define __ARM_PAN_AVAILABLE__     1
 #define __ARM_16K_PG__            1
 
 #define HAS_GIC_V3                1
