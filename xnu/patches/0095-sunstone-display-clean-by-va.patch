+/*
+ * Clean a CPU-written surface to the point of coherency before the GPU reads
+ * it. Not IOMemoryDescriptor::performOperation(kIOMemoryIncoherentIOStore):
+ * for large ranges that does CleanPoC_Dcache(), a set/way clean of the
+ * calling core only, while CoreAnimation draws on the other cores. DC CVAC by
+ * address is broadcast to every core (topaz 0111 does the same).
+ */
+static void
+sweet_clean_poc(uintptr_t va, uint64_t len)
+{
+	uint64_t ctr;
+	__asm__ volatile ("mrs %0, ctr_el0" : "=r"(ctr));
+	uintptr_t line = 4UL << ((ctr >> 16) & 0xf), end = va + len;
+	__builtin_arm_dsb(0xf);
+	for (uintptr_t p = va & ~(line - 1); p < end; p += line) {
+		__asm__ volatile ("dc cvac, %0" :: "r"(p) : "memory");
+	}
+	__builtin_arm_dsb(0xf);
+}
