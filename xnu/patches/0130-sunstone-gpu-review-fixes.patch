+/* Reset only with the ring lock held; keep the client attached until DMA drains. */
+static bool
+gpu_recover(const char *why, struct sweet_gpu_vm *vm)
+{
+	IOLog("SWEET GPU: reset: %s (rptr %x wptr %x rbbm %x hwf %x prot %x)\n",
+	    why, gpu_regs[REG_CP_RB_RPTR], gpu_wptr, gpu_regs[REG_RBBM_STATUS],
+	    gpu_regs[REG_CP_HW_FAULT], gpu_regs[REG_CP_PROTECT_STATUS]);
+	gpu_recovery_streak++;
+	/* Retry only once, with zap resumed, if the first restart fence failed. */
+	for (unsigned attempt = 0; attempt < 2; attempt++) {
+		bool drained = gpu_halt();
+		gpu_assert_reset();
+		gpu_queued = 0;
+		if (!drained) {
+			if (vm != NULL) {
+				vm->quarantined = true;
+			}
+			/* Leave reset asserted and the original SMMU mapping in place. */
+			gpu_off("bus drain failed; reset held, VM pinned");
+			return false;
+		}
+		smmu_detach(NULL, NULL, NULL);
+		if (gpu_recovery_streak >= GPU_MAX_RECOVERY_STREAK) {
+			gpu_off("three consecutive workload failures; reset held");
+			return false;
+		}
+		bool retryable;
+		if (gpu_restart(attempt != 0, &retryable)) {
+			gpu_resets++;
+			IOLog("SWEET GPU: CP recovered (%llu resets), fence %u, failure streak %u\n",
+			    gpu_resets, gpu_seqno, gpu_recovery_streak);
+			return true;
+		}
+		if (attempt == 0 && retryable) {
+			IOLog("SWEET GPU: restart fence failed; retrying once with zap resume\n");
+			continue;
+		}
 		(void)gpu_halt();
 		gpu_assert_reset();
-		gpu_off("CP restart fence failed");
-		return false;
-	}
-	gpu_resets++;
-	IOLog("SWEET GPU: CP recovered (%llu resets), fence %u\n", gpu_resets, gpu_seqno);
-	return true;
+		gpu_off("CP restart failed");
+		return false;
+	}
+	return false;
 }
 
