+void
+AppleCLCD::scanFrom(uint64_t pa, uint32_t stride)
+{
+	fVig0[0x14 / 4] = (uint32_t)pa;         /* SSPP_SRC0_ADDR */
+	fVig0[0x24 / 4] = stride;               /* SSPP_SRC_YSTRIDE0 */
+	__builtin_arm_dsb(0xf);
+	fCtl0[0x18 / 4] = (1u << 17) | (1u << 0); /* CTL_FLUSH: CTL + VIG0, latched at vsync */
+	__builtin_arm_dsb(0xf);
+	fScanPhys = pa;
+}
+
+bool
+AppleCLCD::flipLatched(uint32_t wait_us)
+{
+	for (uint32_t i = 0; i < wait_us / 10; i++) {
+		if ((fCtl0[0x18 / 4] & ((1u << 17) | 1u)) == 0) {
+			return true;
+		}
+		IODelay(10);
+	}
+	return (fCtl0[0x18 / 4] & ((1u << 17) | 1u)) == 0;
+}
+
+/* Back to the splash buffer, carrying the frame on screen over (GPU). */
+void
+AppleCLCD::flipToBoot(void)
+{
+	if (fScanPhys == fPhys) {
+		return;
+	}
+	if (!fGPUFailed && sweet_gpu_copy(fScanPhys, SWEET_FLIP_PITCH, 0, 0, fWidth, fHeight,
+	    fPhys, fRowBytes, 0, 0) && !sweet_gpu_flush()) {
+		fGPUFailed = true;
+	}
+	scanFrom(fPhys, fRowBytes);
+	(void)flipLatched(20000);
+}
