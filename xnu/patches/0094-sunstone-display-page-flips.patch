+/*
+ * One full-screen layer, physically contiguous: GPU copy of the panel
+ * window into the back buffer, then flip. false: use the copy path.
+ */
+bool
+AppleCLCD::flipPresent(const uint8_t *rec)
+{
+	uint32_t mask = get32(rec, 0x104), layer = 0, n = 0;
+	for (uint32_t i = 0; i < SWEET_FB_LAYERS; i++) {
+		if ((mask & (1u << i)) && get32(rec, 0x54 + 4 * i) != 0) {
+			layer = i;
+			n++;
+		}
+	}
+	if (n != 1 || fGPUFailed) {
+		return false;
+	}
+	const uint8_t *a = rec + 0x64 + 16 * layer, *b = rec + 0xc4 + 16 * layer;
+	if (get32(a, 0) != 0 || get32(a, 4) != 0 || get32(b, 0) != 0 || get32(b, 4) != 0 ||
+	    (get32(b, 8) != 0 && get32(b, 8) != fLogicalW) || (get32(b, 12) != 0 && get32(b, 12) != fLogicalH)) {
+		return false;
+	}
+	SweetSurface *s = sweet_surface_copy(get32(rec, 0x54 + 4 * layer));
+	if (s == NULL) {
+		return false;
+	}
+	bool ok = false;
+	if (s != fSurface && s->memory != NULL && s->width == fLogicalW && s->height == fLogicalH &&
+	    s->bytesPerElement == 4 && s->elementWidth == 1 && s->elementHeight == 1) {
+		uint64_t first = (uint64_t)s->offset + (uint64_t)fOffY * s->bytesPerRow + (uint64_t)fOffX * 4;
+		uint64_t last = (uint64_t)s->offset + (uint64_t)(fOffY + fHeight - 1) * s->bytesPerRow +
+		    (uint64_t)(fOffX + fWidth) * 4;
+		IOByteCount seg = 0;
+		addr64_t pa = last <= s->memory->getLength() ?
+		    s->memory->getPhysicalSegment(s->offset, &seg, kIOMemoryMapperNone) : 0;
+		if (pa != 0 && seg >= last - s->offset) {
+			/* the back buffer may still be on screen until the last flip latched */
+			(void)flipLatched(10000);
+			uint32_t back = fScanPhys == sweet_flip_phys[0] ? 1 : 0;
+			uint64_t t0 = mach_absolute_time(), t1, t2, ns;
+			if (s->memory->performOperation(kIOMemoryIncoherentIOStore, first, last - first) == kIOReturnSuccess) {
+				t1 = mach_absolute_time();
+				if (sweet_gpu_copy(pa, s->bytesPerRow, (uint32_t)fOffX, (uint32_t)fOffY, fWidth, fHeight,
+				    sweet_flip_phys[back], SWEET_FLIP_PITCH, 0, 0)) {
+					if (sweet_gpu_flush()) {
+						t2 = mach_absolute_time();
+						scanFrom(sweet_flip_phys[back], SWEET_FLIP_PITCH);
+						absolutetime_to_nanoseconds(t1 - t0, &ns);
+						fStCleanNs += ns;
+						absolutetime_to_nanoseconds(t2 - t1, &ns);
+						fStGpuNs += ns;
+						fStFlips++;
+						ok = true;
+					} else {
+						fGPUFailed = true;
+					}
+				}
+			}
+		}
+	}
+	s->release();
+	return ok;
+}
