diff --git a/bsd/dev/sweet_sample.c b/bsd/dev/sweet_sample.c
index b40eccd..6df21ba 100644
--- a/bsd/dev/sweet_sample.c
+++ b/bsd/dev/sweet_sample.c
@@ -60,6 +60,9 @@ sweet_sample_proc(proc_t p, __unused void *arg)
 	return PROC_RETURNED;
 }
 
+/* osfmk/vm/vm_page.h (not reachable from bsd/): free-page pool, to see VM waits */
+extern unsigned int vm_page_free_count, vm_page_free_target, vm_page_free_min;
+
 static void
 sweet_sample_thread(__unused void *arg, __unused wait_result_t wr)
 {
@@ -72,7 +75,8 @@ sweet_sample_thread(__unused void *arg, __unused wait_result_t wr)
 	}
 	(void)tsleep(&chan, PZERO, "sweetsmp", 90 * hz);
 	for (int i = 0; i < 40; i++) {
-		printf("SMP --- sample %d\n", i);
+		printf("SMP --- sample %d free %u target %u min %u\n", i,
+		    vm_page_free_count, vm_page_free_target, vm_page_free_min);
 		proc_iterate(PROC_ALLPROCLIST, sweet_sample_proc, NULL, NULL, NULL);
 		(void)tsleep(&chan, PZERO, "sweetsmp", 120 * hz);
 	}
diff --git a/osfmk/kern/exception.c b/osfmk/kern/exception.c
index a20a764..bb43bbb 100644
--- a/osfmk/kern/exception.c
+++ b/osfmk/kern/exception.c
@@ -822,7 +822,7 @@ exception_triage(
 
 #if defined(ARM64_BOARD_CONFIG_SWEET)
 #include <vm/vm_shared_region.h>
-#include <arm/thread.h>
+#include <arm/thread.h>        /* also brings thread_get_kernel_state() (its header has no guard) */
 
 /*
  * SWEET crash report on the console. The phone has no way to get crash
@@ -1036,6 +1036,32 @@ sweet_sample_task(const char *name, int pid, task_t task)
 			fp = frame[0];
 		}
 		printf("%s\n", line);
+
+		/*
+		 * sunstone: a thread blocked in the kernel (dyld's first
+		 * mach_vm_allocate never returned): its wait event and the
+		 * kernel frame-pointer chain from the context saved at the
+		 * switch. Only waiting threads, and every frame must lie in the
+		 * thread's own kernel stack.
+		 */
+		if ((thread->state & TH_WAIT) && thread->kernel_stack != 0) {
+			arm_kernel_saved_state_t *ks = &thread_get_kernel_state(thread)->machine.ss;
+			uint64_t lo = thread->kernel_stack, hi = lo + kernel_stack_size;
+			uint64_t kfp = ks->fp;
+			n = snprintf(line, sizeof(line), "SMP %s t%d kst 0x%x wev 0x%llx klr 0x%llx kbt",
+			    name, tn - 1, thread->state, (uint64_t)VM_KERNEL_UNSLIDE_OR_PERM(thread->wait_event),
+			    (uint64_t)VM_KERNEL_UNSLIDE(ks->lr));
+			for (int i = 0; i < 20 && kfp >= lo && kfp + 16 <= hi && (kfp & 7) == 0 &&
+			    n < (int)sizeof(line) - 20; i++) {
+				uint64_t *frame = (uint64_t *)kfp;
+				n += snprintf(line + n, sizeof(line) - n, " 0x%llx", (uint64_t)VM_KERNEL_UNSLIDE(frame[1]));
+				if (frame[0] <= kfp) {
+					break;
+				}
+				kfp = frame[0];
+			}
+			printf("%s\n", line);
+		}
 	}
 	task_unlock(task);
 }
