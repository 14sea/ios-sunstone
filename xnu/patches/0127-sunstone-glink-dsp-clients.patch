+/*
+ * What TopazModem offers to other drivers that talk to the ADSP (sunstone).
+ *
+ * TopazModem boots the ADSP (adsp=1) and runs its GLINK edge on the modem thread. A client
+ * named in TopazModem's dsp_clients[] gets one GLINK channel on that edge: the ADSP opens it,
+ * TopazModem answers, and from then on every callback below runs on the modem thread, so a
+ * client needs no locking against itself. topaz_dsp_send() may only be called from there too.
+ */
+#ifndef _IOKIT_TOPAZDSP_H
+#define _IOKIT_TOPAZDSP_H
+
+#include <stdint.h>
+#include <stdbool.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+struct topaz_dsp_client {
+	const char *channel;                            /* GLINK channel name on the ADSP edge */
+	void (*rx)(const uint8_t *p, uint32_t len);     /* one whole packet from the ADSP */
+	void (*up)(void);                               /* the channel is open both ways (once) */
+	void (*poll)(unsigned ms);                      /* every pass of the ADSP watch, ms since GLINK start */
+	void (*summary)(void);                          /* with the edge summary in the log */
+};
+
+/* queue one packet on the client's channel; false when the channel is not up or the queue is full */
+bool topaz_dsp_send(const struct topaz_dsp_client *c, const void *p, uint32_t len);
+
+/* an SMEM item from the global partition (read-only for the caller), NULL when absent */
+const void *topaz_smem_item(uint16_t item, uint32_t *size);
+
+/* route an apps-smmu stream through a context bank with translation off (IOVA == PA) */
+bool topaz_smmu_identity(uint32_t sid, uint32_t mask, const char *name);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* _IOKIT_TOPAZDSP_H */
