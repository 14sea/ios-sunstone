 }
 
+/* IODisplayParameters = { brightness = { value, min, max } }, as IODisplay publishes */
+void
+AppleARMBacklight::publishParameters(uint32_t value)
+{
+	fValue = value;
+	OSDictionary *params = OSDictionary::withCapacity(1);
+	OSDictionary *br = OSDictionary::withCapacity(3);
+	OSNumber *v = OSNumber::withNumber((unsigned long long)value, 32);
+	OSNumber *mn = OSNumber::withNumber(0ULL, 32);
+	OSNumber *mx = OSNumber::withNumber((unsigned long long)SWEET_BL_MAX, 32);
+	if (params && br && v && mn && mx) {
+		br->setObject("value", v);
+		br->setObject("min", mn);
+		br->setObject("max", mx);
+		params->setObject("brightness", br);
+		setProperty("IODisplayParameters", params);
+	}
+	OSSafeReleaseNULL(v);
+	OSSafeReleaseNULL(mn);
+	OSSafeReleaseNULL(mx);
+	OSSafeReleaseNULL(br);
+	OSSafeReleaseNULL(params);
+}
