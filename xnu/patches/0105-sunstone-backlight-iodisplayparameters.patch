 /*
  * CoreBrightness (-[CBDisplayContaineriOS findBacklight]) matches
  * {IOPropertyMatch: {backlight-control: true}} and requires the class to
- * conform to AppleARMBacklight; without it there is no display module and
- * the brightness slider is dead. It then sets "brightness-nits" here
- * (SetBLDriverNitsValue) and IOMFBBrightnessLevel on the framebuffer.
+ * conform to AppleARMBacklight; then (CBDisplayModuleiOS -> Display.m
+ * DisplayCreateWithID) it reads the macOS-style IODisplayParameters
+ * {brightness = {value, min, max}} from this service (optional:
+ * new-backlight-architecture, backlight-calibration-parameters) and its
+ * brightness thread writes {brightness = N} back with
+ * IORegistryEntrySetCFProperties (___DisplaySetPhysicalBrightnessLegacyOnThread,
+ * "Device brightness %f based on max brightness of %f"). Learned from the
+ * iOS 16.7 CoreBrightness binary; boot-28 showed that without the
+ * parameters nothing is ever written.
  */
+#define SWEET_BL_MAX                    1023    /* IODisplayParameters brightness max */
 class AppleARMBacklight : public IOService {
 	OSDeclareDefaultStructors(AppleARMBacklight);
 public:
 	AppleCLCD *fFB;
+	uint32_t   fValue;
+	void       publishParameters(uint32_t value);
 	IOReturn setProperties(OSObject *properties) APPLE_KEXT_OVERRIDE;
 };
 
