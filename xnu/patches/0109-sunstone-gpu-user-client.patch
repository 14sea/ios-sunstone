+/*
+ * User submissions (SweetGPUDevice.cpp): run dwords of commands at GPU
+ * address iova as an indirect buffer, then flush CCU and UCHE and write a
+ * fence. Returns the fence value to wait for.
+ */
+bool
+sweet_gpu_submit_ib(uint64_t iova, uint32_t dwords, uint32_t *seq_out)
+{
+	if (!gpu_init() || dwords == 0 || dwords >= (1u << 20)) {
+		return false;
+	}
+	IOLockLock(gpu_lock_get());
+	if (gpu_state <= 0 || !ring_space(64)) {
+		IOLockUnlock(gpu_lock);
+		return false;
+	}
+	event(CACHE_INVALIDATE, false);         /* the CPU wrote sources through WC mappings */
+	emit(pkt7(CP_WAIT_FOR_IDLE, 0));
+	emit(pkt7(CP_INDIRECT_BUFFER, 3));
+	emit((uint32_t)iova);
+	emit((uint32_t)(iova >> 32));
+	emit(dwords);
+	event(PC_CCU_FLUSH_COLOR_TS, true);
+	emit(pkt7(CP_WAIT_FOR_IDLE, 0));
+	event(CACHE_FLUSH_TS, true);
+	*seq_out = gpu_seqno;
+	kick();
+	IOLockUnlock(gpu_lock);
+	return true;
+}
+
+bool
+sweet_gpu_wait(uint32_t seq, uint32_t timeout_us)
+{
+	if (gpu_state <= 0) {
+		return false;
+	}
+	for (uint32_t i = 0; i < timeout_us / 10 && !seq_done(seq); i++) {
+		IODelay(10);
+	}
+	return seq_done(seq);
+}
+
+uint64_t
+sweet_gpu_param(uint32_t which)
+{
+	if (!gpu_init()) {
+		return 0;
+	}
+	switch (which) {
+	case SWEET_GPU_PARAM_CHIP_ID:
+		return 0x06010901;              /* Adreno 619 (holi) */
+	case SWEET_GPU_PARAM_GPU_ID:
+		return 619;
+	case SWEET_GPU_PARAM_GMEM_SIZE:
+		return 512 * 1024;
+	case SWEET_GPU_PARAM_FENCE:
+		return *gpu_ctl;
+	case SWEET_GPU_PARAM_STATUS:
+		return gpu_regs[REG_RBBM_STATUS] | ((uint64_t)gpu_regs[REG_CP_HW_FAULT] << 32);
+	default:
+		return 0;
+	}
+}
+
 #else /* !SWEET */
 
