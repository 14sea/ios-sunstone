+/* Wait until the CP has consumed enough of the ring for n more dwords (lock held). */
+static bool
+ring_space(uint32_t n)
+{
+	for (int i = 0; i < 20000; i++) {       /* ~200 ms */
+		uint32_t rptr = gpu_regs[REG_CP_RB_RPTR];
+		uint32_t used = (gpu_wptr + gpu_ring_dwords - rptr) % gpu_ring_dwords;
+		if (used + n + 16 < gpu_ring_dwords) {
+			return true;
+		}
+		IODelay(10);
+	}
+	return false;
+}
