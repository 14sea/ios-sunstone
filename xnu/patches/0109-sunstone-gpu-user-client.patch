diff --git a/iokit/Kernel/arm/SweetGPUDevice.cpp b/iokit/Kernel/arm/SweetGPUDevice.cpp
new file mode 100644
index 0000000..5c71e7a
--- /dev/null
+++ b/iokit/Kernel/arm/SweetGPUDevice.cpp
@@ -0,0 +1,232 @@
+/*
+ * User-space access to the Adreno 619 for SWEET on sunstone: the kernel side
+ * a Mesa freedreno winsys will talk to (a small subset of Linux's msm DRM
+ * driver: buffer objects, indirect-buffer submission, fences).
+ *
+ * SweetGPUDevice (IOResources, published when SweetGPU took the GPU over from
+ * the shim) opens SweetGPUUserClient, whose external methods are:
+ *   0 GetParam   [param]           -> [value]          (SWEET_GPU_PARAM_*)
+ *   1 BONew      [size]            -> [handle, iova, user address, size]
+ *   2 BOFree     [handle]
+ *   3 Submit     [handle, offset, dwords] -> [fence]   commands at iova+offset as an IB
+ *   4 Wait       [fence, timeout ms]       -> status   kIOReturnTimeout if not reached
+ *
+ * Buffer objects are physically contiguous, write-combined in the kernel and
+ * in the client, so the CPU and the GPU see the same bytes without cache
+ * maintenance. GPU addresses are physical (identity GPU SMMU bank), and the
+ * GPU itself is not fenced off from other memory yet: bring-up only.
+ */
+#include "SweetGPU.h"
+
+#include <pexpert/arm64/board_config.h>
+
+#if defined(SWEET)
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOBufferMemoryDescriptor.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOLocks.h>
+#include <IOKit/IOKitKeys.h>
+
+#define SWEET_GPU_MAX_BOS       256
+#define SWEET_GPU_MAX_BO_SIZE   (256u << 20)
+
+class SweetGPUDevice : public IOService {
+	OSDeclareDefaultStructors(SweetGPUDevice);
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(SweetGPUDevice, IOService);
+
+bool
+SweetGPUDevice::start(IOService *provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	if (!sweet_gpu_ready()) {
+		IOLog("SWEET GPU: no GPU from the shim, no SweetGPUDevice\n");
+		return false;
+	}
+	setProperty(kIOUserClientClassKey, "SweetGPUUserClient");
+	registerService();
+	IOLog("SWEET GPU: SweetGPUDevice ready (chip %#llx)\n", sweet_gpu_param(SWEET_GPU_PARAM_CHIP_ID));
+	return true;
+}
+
+struct sweet_gpu_bo {
+	IOBufferMemoryDescriptor *mem;
+	IOMemoryMap              *map;      /* in the client task */
+	uint64_t                  iova;
+	uint32_t                  size;
+};
+
+class SweetGPUUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(SweetGPUUserClient);
+
+	task_t              fTask;
+	IOLock             *fLock;
+	struct sweet_gpu_bo fBOs[SWEET_GPU_MAX_BOS];
+	uint32_t            fLastFence;
+	bool                fFenced;
+
+	void freeBO(uint32_t handle);
+
+public:
+	bool initWithTask(task_t owningTask, void *securityID, UInt32 type) APPLE_KEXT_OVERRIDE;
+	IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	void free(void) APPLE_KEXT_OVERRIDE;
+	IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+	    IOExternalMethodDispatch *dispatch, OSObject *target, void *reference) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(SweetGPUUserClient, IOUserClient);
+
+bool
+SweetGPUUserClient::initWithTask(task_t owningTask, void *securityID, UInt32 type)
+{
+	if (!IOUserClient::initWithTask(owningTask, securityID, type)) {
+		return false;
+	}
+	fTask = owningTask;
+	fLock = IOLockAlloc();
+	bzero(fBOs, sizeof(fBOs));
+	return fLock != NULL;
+}
+
+void
+SweetGPUUserClient::freeBO(uint32_t handle)
+{
+	struct sweet_gpu_bo *bo = &fBOs[handle];
+	/* the GPU may still use it: wait for this client's last submission */
+	if (fFenced) {
+		(void)sweet_gpu_wait(fLastFence, 500000);
+	}
+	OSSafeReleaseNULL(bo->map);
+	OSSafeReleaseNULL(bo->mem);
+	bzero(bo, sizeof(*bo));
+}
+
+IOReturn
+SweetGPUUserClient::clientClose(void)
+{
+	IOLockLock(fLock);
+	for (uint32_t i = 1; i < SWEET_GPU_MAX_BOS; i++) {
+		if (fBOs[i].mem != NULL) {
+			freeBO(i);
+		}
+	}
+	IOLockUnlock(fLock);
+	terminate();
+	return kIOReturnSuccess;
+}
+
+void
+SweetGPUUserClient::free(void)
+{
+	if (fLock != NULL) {
+		IOLockFree(fLock);
+	}
+	IOUserClient::free();
+}
+
+IOReturn
+SweetGPUUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+    IOExternalMethodDispatch *, OSObject *, void *)
+{
+	const uint64_t *in = args->scalarInput;
+	uint32_t nin = args->scalarInputCount;
+	uint64_t *out = args->scalarOutput;
+	IOReturn ret = kIOReturnSuccess;
+
+	IOLockLock(fLock);
+	switch (selector) {
+	case 0:         /* GetParam */
+		if (nin < 1 || args->scalarOutputCount < 1) {
+			ret = kIOReturnBadArgument;
+			break;
+		}
+		out[0] = sweet_gpu_param((uint32_t)in[0]);
+		args->scalarOutputCount = 1;
+		break;
+	case 1: {       /* BONew */
+		if (nin < 1 || args->scalarOutputCount < 4 || in[0] == 0 || in[0] > SWEET_GPU_MAX_BO_SIZE) {
+			ret = kIOReturnBadArgument;
+			break;
+		}
+		uint32_t h = 1;
+		while (h < SWEET_GPU_MAX_BOS && fBOs[h].mem != NULL) {
+			h++;
+		}
+		if (h == SWEET_GPU_MAX_BOS) {
+			ret = kIOReturnNoResources;
+			break;
+		}
+		uint32_t size = (uint32_t)round_page((vm_size_t)in[0]);
+		IOBufferMemoryDescriptor *mem = IOBufferMemoryDescriptor::inTaskWithPhysicalMask(kernel_task,
+		    kIODirectionInOut | kIOMemoryPhysicallyContiguous | kIOMemoryKernelUserShared | kIOMapWriteCombineCache,
+		    size, ~((mach_vm_address_t)page_size - 1));
+		IOMemoryMap *map = NULL;
+		if (mem != NULL) {
+			bzero(mem->getBytesNoCopy(), size);
+			map = mem->createMappingInTask(fTask, 0, kIOMapAnywhere | kIOMapWriteCombineCache);
+		}
+		if (map == NULL) {
+			OSSafeReleaseNULL(mem);
+			ret = kIOReturnNoMemory;
+			break;
+		}
+		fBOs[h].mem = mem;
+		fBOs[h].map = map;
+		fBOs[h].iova = mem->getPhysicalSegment(0, NULL, kIOMemoryMapperNone);
+		fBOs[h].size = size;
+		out[0] = h;
+		out[1] = fBOs[h].iova;
+		out[2] = map->getAddress();
+		out[3] = size;
+		args->scalarOutputCount = 4;
+		break;
+	}
+	case 2:         /* BOFree */
+		if (nin < 1 || in[0] == 0 || in[0] >= SWEET_GPU_MAX_BOS || fBOs[in[0]].mem == NULL) {
+			ret = kIOReturnBadArgument;
+			break;
+		}
+		freeBO((uint32_t)in[0]);
+		break;
+	case 3: {       /* Submit */
+		if (nin < 3 || args->scalarOutputCount < 1 || in[0] == 0 || in[0] >= SWEET_GPU_MAX_BOS ||
+		    fBOs[in[0]].mem == NULL || (in[1] & 3) || in[2] == 0 ||
+		    in[1] + in[2] * 4 > fBOs[in[0]].size) {
+			ret = kIOReturnBadArgument;
+			break;
+		}
+		uint32_t fence = 0;
+		if (!sweet_gpu_submit_ib(fBOs[in[0]].iova + in[1], (uint32_t)in[2], &fence)) {
+			ret = kIOReturnNotReady;
+			break;
+		}
+		fLastFence = fence;
+		fFenced = true;
+		out[0] = fence;
+		args->scalarOutputCount = 1;
+		break;
+	}
+	case 4:         /* Wait */
+		if (nin < 2) {
+			ret = kIOReturnBadArgument;
+			break;
+		}
+		IOLockUnlock(fLock);    /* do not hold the client while sleeping */
+		return sweet_gpu_wait((uint32_t)in[0], (uint32_t)(in[1] > 10000 ? 10000000 : in[1] * 1000)) ?
+		       kIOReturnSuccess : kIOReturnTimeout;
+	default:
+		ret = kIOReturnUnsupported;
+		break;
+	}
+	IOLockUnlock(fLock);
+	return ret;
+}
+
+#endif /* SWEET */
